<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deflate compressor of zlib, ported to C# by DotNetZip and carried by SharpCompress, under the Microsoft Public
    License (License.txt of this folder): a library apart from the code of RomSieve, see README.md.
  -->
