<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RomSieve.App.ViewModels"
        xmlns:controls="using:RomSieve.App.Controls"
        x:Class="RomSieve.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="960"
        MinHeight="580"
        Icon="avares://RomSieve.App/Assets/icon.png"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="11"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <x:Double x:Key="TabItemHeaderFontSize">11</x:Double>
    <x:Double x:Key="TabItemMinHeight">26</x:Double>
    <Thickness x:Key="TabItemHeaderMargin">0,0,2,0</Thickness>
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />

    <!-- Chip of an ordered language or country list: rank, label, code and a cross to remove it. It is reordered by
         drag-and-drop (MainWindow code-behind) or by its context menu -->
    <DataTemplate x:Key="PriorityChipTemplate" x:DataType="vm:PriorityItemViewModel">
      <Border Classes="priority-chip"
              DragDrop.AllowDrop="True"
              ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.tooltip_chip]}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.menu_move_top]}"
                      IsEnabled="{Binding CanMoveUp}"
                      Command="{Binding MoveToTopCommand}" />
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.menu_move_up]}"
                      IsEnabled="{Binding CanMoveUp}"
                      Command="{Binding MoveUpCommand}" />
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.menu_move_down]}"
                      IsEnabled="{Binding CanMoveDown}"
                      Command="{Binding MoveDownCommand}" />
            <Separator />
            <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.menu_remove]}"
                      Command="{Binding RemoveCommand}" />
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Classes="chip-rank" Text="{Binding RankIndex}" VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center">
            <Run Text="{Binding Label}" /> <Run Text="{Binding Code}" Foreground="{DynamicResource HintForegroundBrush}" />
          </TextBlock>
          <Button Classes="chip-remove"
                  Content="×"
                  ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.tooltip_remove]}"
                  AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[chips.tooltip_remove]}"
                  Command="{Binding RemoveCommand}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Item of the search list of the "Add" button: a click adds it at the end of the chips -->
    <DataTemplate x:Key="AvailablePriorityItemTemplate" x:DataType="vm:PriorityItemViewModel">
      <Button Classes="available-item" Command="{Binding AddCommand}">
        <TextBlock>
          <Run Text="{Binding Label}" /> <Run Text="{Binding Code}" Foreground="{DynamicResource HintForegroundBrush}" />
        </TextBlock>
      </Button>
    </DataTemplate>

    <!-- Entry of the navigation: number, label and the state line of the step (missing source, results…) -->
    <DataTemplate x:Key="NavigationStepTemplate" x:DataType="vm:NavigationStepViewModel">
      <Button Classes="nav-step"
              Classes.current="{Binding IsSelectedStep}"
              Classes.group-current="{Binding IsSelectedGroup}"
              Classes.sub="{Binding IsSubStep}"
              ToolTip.Tip="{Binding Tooltip}"
              Command="{Binding SelectCommand}">
        <!-- A sub-step has no number: its indentation puts its label under the label of its group -->
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Width="18" Text="{Binding Number}" IsVisible="{Binding HasNumber}" FontWeight="Bold" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding IndicatorText}"
                       IsVisible="{Binding HasIndicator}"
                       ToolTip.Tip="{Binding IndicatorTooltip}"
                       FontSize="10"
                       FontWeight="Normal"
                       TextTrimming="CharacterEllipsis">
              <TextBlock.Foreground>
                <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Step*IndicatorBrush|StepNoneIndicatorBrush">
                  <Binding Path="IndicatorTone" />
                  <Binding Path="$self.ActualThemeVariant" />
                </MultiBinding>
              </TextBlock.Foreground>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- Tooltip appearance delay set to 1 second (1000 ms) -->
    <Style Selector=":is(Control)">
      <Setter Property="ToolTip.ShowDelay" Value="1000" />
    </Style>

    <!-- Compact style for tabs -->
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0,3,3,3" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TabSelectedForegroundBrush}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="0" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="0" />
    </Style>

    <!-- Section titles: a title and spacing instead of a frame around each group of options -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <!-- A drop-down panel wider than the default limit of Fluent: the order of the 1G1R criteria, whose lines carry the
         list of the preference they compare to -->
    <Style Selector="FlyoutPresenter.wide-panel">
      <Setter Property="MaxWidth" Value="640" />
    </Style>

    <!-- A sentence that keeps its room while it does not apply, so that its panel keeps its size -->
    <Style Selector="TextBlock.reserved-hidden">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Settings pages: a frame per group of settings, lighter than the page, with its title; in a frame, the labels
         of the form are in a column of their own, without colon, and the hints are grey -->
    <Style Selector="Border.settings-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8,12,10" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A frame of MAME settings, in the colours of the MAME convention badge while the MAME convention is in use -->
    <Style Selector="Border.settings-card.mame">
      <Setter Property="Background" Value="{DynamicResource BadgeMameBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BadgeMameBorderBrush}" />
    </Style>
    <Style Selector="Border.settings-card.mame TextBlock.card-title">
      <Setter Property="Foreground" Value="{DynamicResource BadgeMameForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.form-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.form-hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>
    <!-- 1G1R criterion that cannot separate two releases of the current collection: greyed out, its tooltip says why -->
    <Style Selector="TextBlock.no-effect">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>
    <!-- Games a 1G1R criterion decided in the last simulation, aligned on the right of the criterion -->
    <Style Selector="TextBlock.decided-count">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- The whole height of the row is clickable. One width up to four digits, aligned on the right, so that the lists
         set on the lines of their criteria line up whatever the counts -->
    <Style Selector="Button.decided-count">
      <Setter Property="Margin" Value="6,-1,0,-1" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.decided-count:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.decided-count:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.decided-count.decided-nothing">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>
    <Style Selector="Run.optional">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>
    <!-- Tag after the label of a box ("(hack)", "[b]"): lighter than the label while the box is enabled; disabled, it
         inherits the greyed-out color of the label, which a Foreground set on the Run itself would override -->
    <Style Selector=":is(ToggleButton):not(:disabled) Run.tag">
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>

    <!-- Cross at the end of a file or folder field, shown while the field holds a path: it empties the field -->
    <Style Selector="Button.field-clear">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Content" Value="✕" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>

    <!-- Advanced options button: emphasized while an option differs from its default -->
    <Style Selector="DropDownButton.advanced-options.changed">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Compact form controls (1080p) -->
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="5,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <!-- A Button selector does not match a DropDownButton, which would keep the grey background of the Fluent theme and
         look disabled next to the other buttons: only its colours and frame are aligned, its size stays its own -->
    <Style Selector="DropDownButton">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <!-- Nor a ToggleButton ("Group by game"): unchecked, it looked disabled; checked, it keeps the accent of the Fluent
         theme. The chips of the statistics banner have their own style -->
    <Style Selector="ToggleButton:not(.stat-chip)">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- Chips of the ordered language and country lists, and the items of their search list -->
    <Style Selector="Border.priority-chip">
      <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="8,1,2,1" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="Border.priority-chip:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource PriorityChipFocusBorderBrush}" />
    </Style>
    <Style Selector="Border.priority-chip TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.chip-rank">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.chip-remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.available-item">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- List of the 1G1R criteria order -->
    <Style Selector="ListBox.priority-list">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- Room on the right for the scroll bar, which widens over the items when the pointer comes near it -->
    <Style Selector="ListBox.priority-list > ListBoxItem">
      <Setter Property="Padding" Value="4,1,12,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Statistics banner chips (StatsBanner) -->
    <Style Selector="ToggleButton.stat-chip">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton#ChipTotal">
      <Setter Property="Foreground" Value="{DynamicResource ChipTotalBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipTotal:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipTotalCheckedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipTotalBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipValid">
      <Setter Property="Foreground" Value="{DynamicResource ChipValidBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipValid:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipValidBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipValidBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipExcluded">
      <Setter Property="Foreground" Value="{DynamicResource ChipExcludedBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipExcluded:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipExcludedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipExcludedBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipUnmatched">
      <Setter Property="Foreground" Value="{DynamicResource ChipUnmatchedBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipUnmatched:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipUnmatchedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipUnmatchedBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipDuplicates">
      <Setter Property="Foreground" Value="{DynamicResource ChipDuplicatesBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipDuplicates:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipDuplicatesBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipDuplicatesBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipChanged">
      <Setter Property="Foreground" Value="{DynamicResource ChipChangedBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipChanged:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipChangedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipChangedBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipSelection">
      <Setter Property="Foreground" Value="{DynamicResource ChipSelectionBrush}" />
    </Style>
    <Style Selector="ToggleButton#ChipSelection:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChipSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ChipCheckedForegroundBrush}" />
    </Style>

    <!-- Action bar: the main button simulates, or stops a running operation (class "stop"); the sort button is put
         forward (class "primary") only after a simulation of the current options; the other actions are secondary -->
    <Style Selector="Button#BtnSimulate">
      <Setter Property="Background" Value="{DynamicResource SimulateButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SimulateButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button#BtnSimulate:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SimulateButtonHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button#BtnSimulate.stop">
      <Setter Property="Background" Value="{DynamicResource StopButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StopButtonBorderBrush}" />
    </Style>
    <Style Selector="Button#BtnSimulate.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StopButtonHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.secondary-action">
      <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button#BtnStart.primary">
      <Setter Property="Background" Value="{DynamicResource StartButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StartButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button#BtnStart.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StartButtonHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
    </Style>
    <!-- Menu of the partial sorts, joined to the sort button and coloured like it -->
    <Style Selector="DropDownButton#BtnPartialSortMenu">
      <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="DropDownButton#BtnPartialSortMenu.primary">
      <Setter Property="Background" Value="{DynamicResource StartButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StartButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
    </Style>
    <!-- The Fluent theme paints the hovered and pressed background on the border of the template, not on its content
         (a few pixels wide next to the arrow): the whole button is coloured there, arrow included -->
    <Style Selector="DropDownButton#BtnPartialSortMenu.primary:pointerover /template/ Border#RootBorder">
      <Setter Property="Background" Value="{DynamicResource StartButtonHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StartButtonBorderBrush}" />
    </Style>
    <Style Selector="DropDownButton#BtnPartialSortMenu.primary:pressed /template/ Border#RootBorder">
      <Setter Property="Background" Value="{DynamicResource StartButtonHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StartButtonBorderBrush}" />
    </Style>
    <Style Selector="DropDownButton#BtnPartialSortMenu.primary:pointerover /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
    </Style>
    <Style Selector="DropDownButton#BtnPartialSortMenu.primary:pressed /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}" />
    </Style>
    <!-- Second line of a menu item: what the action does, or why it is not available -->
    <Style Selector="TextBlock.menu-detail">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>

    <!-- Compact DataGrid preview table -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Each cell shows the tooltip of its row, anchored below the cell with no vertical offset. A tooltip shown at the
         pointer (default placement) is flipped above it near the bottom of the screen while keeping its 20 px offset
         downwards: it then covers the pointer, which leaves the row and closes it at once, over and over (flickering
         cursor, tooltip never drawn). Flipped above the cell, it can no longer cover the pointer.
         BetweenShowDelay at 0: moving across the table must not open one popup per cell without delay. -->
    <Style Selector="DataGridRow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="21" />
    </Style>
    <!-- Sort arrow of the preview table, sorted by the ViewModel (MainWindow.UpdatePreviewSortIndicators):
         the DataGrid only shows it for its own sort -->
    <Style Selector="DataGridColumnHeader.sort-ascending /template/ Path#SortIcon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DataGridSortIconAscendingPath}" />
    </Style>
    <Style Selector="DataGridColumnHeader.sort-descending /template/ Path#SortIcon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{DynamicResource DataGridSortIconDescendingPath}" />
    </Style>

    <!-- Title of a game in the view grouped by game of the preview table -->
    <Style Selector="TextBlock.group-title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGridCell" x:DataType="vm:PreviewRowViewModel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="21" />
      <Setter Property="ToolTip.Tip" Value="{Binding TooltipText}" />
      <Setter Property="ToolTip.Placement" Value="BottomEdgeAlignedLeft" />
      <Setter Property="ToolTip.VerticalOffset" Value="0" />
      <Setter Property="ToolTip.ShowDelay" Value="300" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="0" />
    </Style>

    <!-- Navigation by steps: one entry per step, the shown one marked on its left; the sub-steps are indented -->
    <Style Selector="Button.nav-step">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="0,3,3,0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav-step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
    </Style>
    <Style Selector="Button.nav-step.sub">
      <Setter Property="Margin" Value="18,0,0,0" />
    </Style>
    <Style Selector="Button.nav-step.group-current">
      <Setter Property="Foreground" Value="{DynamicResource NavSelectedForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav-step.group-current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource NavSelectedForegroundBrush}" />
    </Style>
    <Style Selector="Button.nav-step.current">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NavSelectedMarkerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavSelectedForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav-step.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NavSelectedMarkerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NavSelectedForegroundBrush}" />
    </Style>

    <!-- Page of a settings step: the frame the configuration tabs had -->
    <Style Selector="Border.step-page">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="6,6,6,6">

    <!-- =================================================================== -->
    <!-- UPDATE NOTIFICATION BANNER                                          -->
    <!-- =================================================================== -->
    <Border DockPanel.Dock="Top"
            x:Name="BannerUpdateAvailable"
            IsVisible="{Binding Updates.IsNotificationVisible}"
            Background="{DynamicResource UpdateBannerBackgroundBrush}"
            BorderBrush="{DynamicResource UpdateBannerBorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="8,4"
            Margin="0,0,0,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="BtnViewUpdate"
                  Content="{Binding I18n[update.btn_view_release]}"
                  Command="{Binding Updates.OpenReleasePageCommand}"
                  FontSize="11"
                  Padding="8,2" />
          <Button x:Name="BtnIgnoreUpdate"
                  Content="{Binding I18n[update.btn_ignore_version]}"
                  Command="{Binding Updates.IgnoreVersionCommand}"
                  FontSize="11"
                  Padding="8,2" />
          <Button x:Name="BtnDismissUpdate"
                  ToolTip.Tip="{Binding I18n[update.tooltip_dismiss]}"
                  Command="{Binding Updates.DismissNotificationCommand}"
                  Padding="7,5"
                  VerticalAlignment="Stretch">
            <!-- Drawn cross: a glyph such as U+2715 is missing from Inter and from some Linux fonts -->
            <Path Data="M0,0 L8,8 M8,0 L0,8"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.5"
                  Width="8"
                  Height="8" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding Updates.NotificationMessage}"
                   Foreground="{DynamicResource UpdateBannerForegroundBrush}"
                   FontWeight="SemiBold"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- =================================================================== -->
    <!-- TOP BAR: profiles menu and preferences window                       -->
    <!-- =================================================================== -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <Button x:Name="BtnPreferences"
              DockPanel.Dock="Right"
              Content="{Binding I18n[app.btn_preferences]}"
              ToolTip.Tip="{Binding I18n[app.tooltip_preferences]}"
              FontSize="11"
              Padding="10,2"
              VerticalAlignment="Center"
              Command="{Binding Preferences.OpenCommand}" />

      <DropDownButton x:Name="BtnProfileMenu"
                      DockPanel.Dock="Left"
                      HorizontalAlignment="Left"
                      Content="{Binding I18n[app.btn_profile_menu]}"
                      ToolTip.Tip="{Binding I18n[app.tooltip_profile_menu]}"
                      FontSize="11"
                      MinHeight="24"
                      Padding="10,2"
                      VerticalAlignment="Center">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem x:Name="MenuSaveProfile"
                      Header="{Binding I18n[app.btn_save_profile]}"
                      ToolTip.Tip="{Binding I18n[app.tooltip_save_profile]}"
                      Command="{Binding Profiles.SaveProfileCommand}" />
            <MenuItem x:Name="MenuLoadProfile"
                      Header="{Binding I18n[app.btn_load_profile]}"
                      ToolTip.Tip="{Binding I18n[app.tooltip_load_profile]}"
                      Command="{Binding Profiles.LoadProfileCommand}" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </DockPanel>

    <!-- =================================================================== -->
    <!-- FOOTER: progress (only while an operation runs) and actions, shown  -->
    <!-- on every step                                                       -->
    <!-- =================================================================== -->
    <Border x:Name="ActionFooter"
            DockPanel.Dock="Bottom"
            Margin="0,6,0,0"
            Padding="0,6,0,0"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Spacing="4">
        <!-- Unified progress bar + fixed-width labels (flicker-free), only while an operation runs -->
        <Grid x:Name="ProgressRow"
              ColumnDefinitions="250,*,155,90"
              Margin="0"
              VerticalAlignment="Center"
              IsVisible="{Binding Execution.IsProgressVisible}">
          <TextBlock x:Name="LblStatusMsg"
                     Grid.Column="0"
                     Width="250"
                     FontSize="11"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Execution.StatusMessage}"
                     ToolTip.Tip="{Binding Execution.RawStatusMessage}" />

          <Grid Grid.Column="1" Margin="8,0" Height="16" VerticalAlignment="Center">
            <ProgressBar x:Name="ProgressBar"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Execution.ProgressPercentage}"
                         ToolTip.Tip="{Binding I18n[panel4.tooltip_progress_bar]}"
                         ShowProgressText="False"
                         Background="{DynamicResource ProgressTrackBrush}"
                         Foreground="{DynamicResource ProgressFillBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}"
                         BorderThickness="1"
                         CornerRadius="4" />
            <TextBlock Text="{Binding Execution.ProgressPercentage, StringFormat={}{0}%}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock x:Name="LblCounts"
                     Grid.Column="2"
                     Width="155"
                     FontSize="11"
                     TextAlignment="Right"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding I18n[panel4.tooltip_counts]}"
                     Text="{Binding Execution.CountsText}" />

          <TextBlock x:Name="LblEta"
                     Grid.Column="3"
                     Width="90"
                     FontSize="11"
                     TextAlignment="Right"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding I18n[panel4.tooltip_eta]}"
                     Text="{Binding Execution.EtaText}" />
        </Grid>

        <!-- Progress of a DAT export, which may read the files the DAT does not describe, or select the games of the
             catalog (a step without count), with its stop button -->
        <Grid x:Name="ExportProgressRow"
              ColumnDefinitions="250,*,Auto"
              VerticalAlignment="Center"
              IsVisible="{Binding Export.IsExporting}">
          <TextBlock x:Name="LblExportProgress"
                     Grid.Column="0"
                     Width="250"
                     FontSize="11"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Export.ExportProgressText}"
                     ToolTip.Tip="{Binding I18n[panel4.tooltip_export_progress]}" />

          <Grid Grid.Column="1" Margin="8,0" Height="16" VerticalAlignment="Center">
            <ProgressBar x:Name="ExportProgressBar"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Export.ExportProgressPercentage}"
                         IsIndeterminate="{Binding Export.IsExportProgressIndeterminate}"
                         ToolTip.Tip="{Binding Export.ExportCurrentFile}"
                         ShowProgressText="False"
                         Background="{DynamicResource ProgressTrackBrush}"
                         Foreground="{DynamicResource ProgressFillBrush}"
                         BorderBrush="{DynamicResource ControlBorderBrush}"
                         BorderThickness="1"
                         CornerRadius="4" />
            <TextBlock Text="{Binding Export.ExportProgressPercentage, StringFormat={}{0}%}"
                       IsVisible="{Binding !Export.IsExportProgressIndeterminate}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>

          <Button x:Name="BtnStopExport"
                  Grid.Column="2"
                  Classes="stop"
                  FontSize="11"
                  Content="{Binding I18n[panel4.btn_stop_export]}"
                  ToolTip.Tip="{Binding I18n[panel4.tooltip_stop_export]}"
                  Command="{Binding Export.CancelExportCommand}" />
        </Grid>

        <!-- Main action (simulate or stop), sort, undo, summary of the next sort and export menu -->
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
            <Button x:Name="BtnSimulate"
                    MinWidth="130"
                    Classes.stop="{Binding Execution.IsPipelineRunning}"
                    Content="{Binding Execution.PrimaryActionText}"
                    ToolTip.Tip="{Binding Execution.PrimaryActionTooltip}"
                    ToolTip.ShowOnDisabled="True"
                    FontSize="11"
                    Command="{Binding Execution.PrimaryActionCommand}" />
            <!-- The sort button and its menu of partial sorts form one split button -->
            <StackPanel Orientation="Horizontal">
              <!-- Sorts the checked games while there are some, otherwise the whole simulation -->
              <Button x:Name="BtnStart"
                      Classes="secondary-action"
                      Classes.primary="{Binding PartialSort.IsStartPutForward}"
                      CornerRadius="3,0,0,3"
                      Content="{Binding PartialSort.StartButtonText}"
                      ToolTip.Tip="{Binding PartialSort.StartButtonTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      FontSize="11"
                      Command="{Binding PartialSort.StartCommand}" />
              <DropDownButton x:Name="BtnPartialSortMenu"
                              Classes.primary="{Binding PartialSort.IsStartPutForward}"
                              CornerRadius="0,3,3,0"
                              BorderThickness="0,1,1,1"
                              MinHeight="24"
                              Padding="2,2"
                              VerticalAlignment="Stretch"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_partial_sort_menu]}"
                              IsEnabled="{Binding Execution.CanStartOperation}">
                <DropDownButton.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedLeft">
                    <!-- While some games are unchecked, the sort button sorts the checked ones: the whole simulation is sorted from here -->
                    <MenuItem x:Name="MenuSortAll"
                              IsVisible="{Binding PartialSort.IsPartialSelection}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_menu_sort_all]}"
                              Command="{Binding Execution.StartSortCommand}">
                      <MenuItem.Header>
                        <StackPanel Spacing="1" MaxWidth="460">
                          <TextBlock Text="{Binding I18n[panel4.menu_sort_all]}" />
                          <TextBlock x:Name="LblSortAllSummary"
                                     Classes="menu-detail"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding Execution.IsSortSummaryVisible}"
                                     Text="{Binding Execution.SortSummaryText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="MenuSortDisplayed"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_menu_sort_displayed]}"
                              Command="{Binding PartialSort.SortDisplayedCommand}">
                      <MenuItem.Header>
                        <StackPanel Spacing="1" MaxWidth="460">
                          <TextBlock Text="{Binding I18n[panel4.menu_sort_displayed]}" />
                          <TextBlock x:Name="LblSortDisplayedSummary"
                                     Classes="menu-detail"
                                     TextWrapping="Wrap"
                                     Text="{Binding PartialSort.DisplayedSummaryText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </StackPanel>
            <Button x:Name="BtnUndo"
                    Classes="secondary-action"
                    Content="{Binding I18n[panel4.btn_undo]}"
                    ToolTip.Tip="{Binding I18n[panel4.tooltip_undo]}"
                    FontSize="11"
                    Command="{Binding Execution.UndoLastSortCommand}" />
          </StackPanel>

          <DropDownButton x:Name="BtnExportMenu"
                          DockPanel.Dock="Right"
                          Margin="6,0,0,0"
                          Content="{Binding I18n[panel4.btn_export_menu]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_export_menu]}"
                          FontSize="11"
                          MinHeight="24"
                          Padding="10,2"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding Export.CanExportAny}">
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="MenuExportReport"
                          Header="{Binding I18n[panel4.btn_export]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_export_report]}"
                          Command="{Binding ExportReportCommand}" />
                <MenuItem x:Name="MenuExportDat"
                          Header="{Binding I18n[panel4.btn_export_dat]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_export_dat]}"
                          Command="{Binding ExportDatCommand}" />
                <MenuItem x:Name="MenuExportMissList"
                          Header="{Binding I18n[panel4.btn_export_miss_list]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_export_miss_list]}"
                          Command="{Binding ExportMissListCommand}" />
                <!-- Above, the results of the last run; below, the DAT alone, without a run -->
                <Separator />
                <MenuItem x:Name="MenuExportCatalogDat"
                          Header="{Binding I18n[panel4.btn_export_catalog_dat]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_export_catalog_dat]}"
                          ToolTip.ShowOnDisabled="True"
                          Command="{Binding Export.ExportCatalogDatCommand}" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>

          <!-- What the sort will do, shown after a simulation of the current options -->
          <TextBlock x:Name="LblSortSummary"
                     Margin="10,0,0,0"
                     FontSize="11"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     IsVisible="{Binding PartialSort.IsFooterSummaryVisible}"
                     Text="{Binding PartialSort.FooterSummaryText}"
                     ToolTip.Tip="{Binding PartialSort.FooterSummaryTooltip}" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- =================================================================== -->
    <!-- NAVIGATION BY STEPS, in the order of the pipeline                   -->
    <!-- =================================================================== -->
    <StackPanel x:Name="NavigationPanel"
                DockPanel.Dock="Left"
                Width="160"
                Margin="0,0,6,0"
                Spacing="2">
      <ContentControl x:Name="NavCollection" Content="{Binding Navigation.CollectionEntry}" ContentTemplate="{StaticResource NavigationStepTemplate}" HorizontalContentAlignment="Stretch" />
      <ContentControl x:Name="NavSelection" Content="{Binding Navigation.SelectionEntry}" ContentTemplate="{StaticResource NavigationStepTemplate}" HorizontalContentAlignment="Stretch" />
      <ContentControl x:Name="NavFilters" Content="{Binding Navigation.FiltersEntry}" ContentTemplate="{StaticResource NavigationStepTemplate}" HorizontalContentAlignment="Stretch" />
      <ContentControl x:Name="NavLanguages" Content="{Binding Navigation.LanguagesEntry}" ContentTemplate="{StaticResource NavigationStepTemplate}" HorizontalContentAlignment="Stretch" />
      <ContentControl x:Name="NavOutput" Content="{Binding Navigation.OutputEntry}" ContentTemplate="{StaticResource NavigationStepTemplate}" HorizontalContentAlignment="Stretch" />
      <Separator Margin="0,6" />
      <ContentControl x:Name="NavResults" Content="{Binding Navigation.ResultsEntry}" ContentTemplate="{StaticResource NavigationStepTemplate}" HorizontalContentAlignment="Stretch" />
    </StackPanel>

    <!-- =================================================================== -->
    <!-- PAGES OF THE STEPS: all kept alive, only the current one is shown,  -->
    <!-- so that the preview table keeps its rows, selection and scrolling   -->
    <!-- =================================================================== -->
    <Panel x:Name="StepContent">

      <!-- =============================================================== -->
      <!-- STEP 1: Collection, in the order of the need: the source (the   -->
      <!-- only thing required), the DAT and the convention it detects,    -->
      <!-- then the optional files of a MAME collection                    -->
      <!-- =============================================================== -->
      <Border x:Name="PageCollection" Classes="step-page" IsVisible="{Binding Navigation.IsCollectionShown}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <!-- The labels of every frame share one column, so that the fields line up from one frame to the next -->
          <StackPanel Margin="4,2" Spacing="12" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">

            <!-- Source -->
            <Border x:Name="CardSource" Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Classes="card-title" Text="{Binding I18n[tab1.card_source]}" />
                <Grid RowDefinitions="Auto,6,Auto">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CollectionLabel" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Classes="form-label" Text="{Binding I18n[tab1.lbl_source]}" />
                  <TextBox x:Name="EditSource"
                           Grid.Row="0"
                           Grid.Column="2"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_source]}"
                           Watermark="{Binding I18n[tab1.edit_source_placeholder]}"
                           Text="{Binding Directories.SourceDir, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <Button x:Name="BtnClearSource"
                              Classes="field-clear"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_clear_source]}"
                              AutomationProperties.Name="{Binding I18n[tab1.tooltip_clear_source]}"
                              IsVisible="{Binding Directories.SourceDir, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Command="{Binding Directories.ClearSourceCommand}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="BtnBrowseSource"
                          Grid.Row="0"
                          Grid.Column="4"
                          Content="{Binding I18n[tab1.btn_browse]}"
                          ToolTip.Tip="{Binding I18n[tab1.tooltip_browse_source]}"
                          FontSize="11"
                          Command="{Binding Directories.BrowseSourceCommand}" />

                  <!-- Scan option, and the advanced options in a drop-down panel: it opens over the page and never
                       changes its layout. The button counts the options that differ from their default -->
                  <WrapPanel Grid.Row="2"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Orientation="Horizontal">
                    <CheckBox x:Name="ChkRecursive"
                              Margin="0,0,10,0"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_recursive]}"
                              Content="{Binding I18n[tab1.chk_recursive]}"
                              IsChecked="{Binding Directories.IsRecursive, Mode=TwoWay}" />
                    <DropDownButton x:Name="BtnAdvancedDirectories"
                                    Classes="advanced-options"
                                    Classes.changed="{Binding Directories.Advanced.HasChangedOptions}"
                                    Margin="0"
                                    MinHeight="24"
                                    Padding="10,2"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Content="{Binding Directories.Advanced.HeaderText}"
                                    ToolTip.Tip="{Binding Directories.Advanced.HeaderTooltip}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="PanelAdvancedDirectories" Spacing="4">
                            <CheckBox x:Name="ChkScanArchives"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab1.tooltip_scan_archives]}"
                                      Content="{Binding I18n[tab1.chk_scan_archives]}"
                                      IsChecked="{Binding Directories.ScanArchives, Mode=TwoWay}" />
                            <CheckBox x:Name="ChkVerifySha1"
                                      FontSize="11"
                                      Content="{Binding I18n[tab1.chk_verify_sha1]}"
                                      ToolTip.Tip="{Binding I18n[tab1.tooltip_verify_sha1]}"
                                      IsChecked="{Binding Directories.VerifySha1, Mode=TwoWay}" />
                            <CheckBox x:Name="ChkVerifyArchiveContents"
                                      FontSize="11"
                                      Content="{Binding I18n[tab1.chk_verify_archive_contents]}"
                                      ToolTip.Tip="{Binding I18n[tab1.tooltip_verify_archive_contents]}"
                                      IsChecked="{Binding Directories.VerifyArchiveContents, Mode=TwoWay}" />
                            <CheckBox x:Name="ChkMatchChdByName"
                                      FontSize="11"
                                      Content="{Binding I18n[tab1.chk_match_chd_by_name]}"
                                      ToolTip.Tip="{Binding I18n[tab1.tooltip_match_chd_by_name]}"
                                      IsChecked="{Binding Directories.MatchChdByName, Mode=TwoWay}" />
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                  </WrapPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- DAT catalogue, and the convention it detects -->
            <Border x:Name="CardDat" Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Classes="card-title">
                  <Run Text="{Binding I18n[tab1.card_dat]}" /> <Run Classes="optional" Text="{Binding I18n[tab1.optional]}" />
                </TextBlock>
                <Grid RowDefinitions="Auto,2,Auto,6,Auto,8,Auto">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CollectionLabel" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Classes="form-label" Text="{Binding I18n[tab1.lbl_dat]}" />
                  <TextBox x:Name="EditDat"
                           Grid.Row="0"
                           Grid.Column="2"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_dat]}"
                           Watermark="{Binding I18n[tab1.edit_dat_placeholder]}"
                           Text="{Binding Directories.DatFilePath, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <Button x:Name="BtnClearDat"
                              Classes="field-clear"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_clear_dat]}"
                              AutomationProperties.Name="{Binding I18n[tab1.tooltip_clear_dat]}"
                              IsVisible="{Binding Directories.DatFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Command="{Binding Directories.ClearDatCommand}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <!-- A DAT file, or a folder of DATs: a lot of No-Intro, Redump or TOSEC DATs, or the DATs of several MAME
                       software lists -->
                  <Button x:Name="BtnBrowseDat"
                          Grid.Row="0"
                          Grid.Column="4"
                          Content="{Binding I18n[tab1.btn_browse]}"
                          ToolTip.Tip="{Binding I18n[tab1.tooltip_browse_dat]}"
                          FontSize="11">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem x:Name="MenuBrowseDatFile"
                                  Header="{Binding I18n[tab1.menu_browse_dat_file]}"
                                  Command="{Binding Directories.BrowseDatCommand}" />
                        <MenuItem x:Name="MenuBrowseDatFolder"
                                  Header="{Binding I18n[tab1.menu_browse_dat_folder]}"
                                  ToolTip.Tip="{Binding I18n[tab1.tooltip_browse_dat_folder]}"
                                  Command="{Binding Directories.BrowseDatFolderCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>

                  <!-- What the DAT holds, or, without a DAT, what that changes; the button that opens the DATs of a lot to
                       check (DatLotWindow), greyed without a lot -->
                  <DockPanel Grid.Row="2"
                             Grid.Column="2"
                             Grid.ColumnSpan="3">
                    <Button x:Name="BtnChooseLotDats"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            FontSize="11"
                            Content="{Binding I18n[tab1.btn_choose_lot_dats]}"
                            ToolTip.Tip="{Binding I18n[tab1.tooltip_choose_lot_dats]}"
                            ToolTip.ShowOnDisabled="True"
                            IsEnabled="{Binding Directories.DatLot.IsLot}"
                            Command="{Binding Directories.ChooseLotDatsCommand}" />
                    <!-- While a folder of DATs is read: the DATs read out of those of the folder (no value while it is listed) -->
                    <StackPanel x:Name="PanelDatFolderRead"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Directories.IsReadingDatFolder}">
                      <ProgressBar x:Name="ProgressDatFolderRead"
                                   Width="100"
                                   MinWidth="100"
                                   VerticalAlignment="Center"
                                   Minimum="0"
                                   Maximum="{Binding Directories.DatFolderReadTotal}"
                                   Value="{Binding Directories.DatFolderReadCount}"
                                   IsIndeterminate="{Binding !Directories.IsDatFolderReadCountKnown}" />
                      <TextBlock x:Name="LblDatFolderRead"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Text="{Binding Directories.DatFolderReadText}" />
                    </StackPanel>
                    <Panel>
                      <TextBlock x:Name="LblDatInfo"
                                 VerticalAlignment="Center"
                                 Text="{Binding Directories.DatInfoText}"
                                 ToolTip.Tip="{Binding I18n[tab1.tooltip_dat_info]}"
                                 FontStyle="Italic"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Directories.DatInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="DatInfo*ForegroundBrush">
                            <Binding Path="Directories.DatInfoTone" />
                            <Binding Path="$self.ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                      <TextBlock x:Name="LblNoDatHint"
                                 VerticalAlignment="Center"
                                 Classes="form-hint"
                                 Text="{Binding I18n[tab1.hint_no_dat]}"
                                 IsVisible="{Binding Directories.DatFilePath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                    </Panel>
                  </DockPanel>

                  <!-- The subfolders of a folder of DATs, greyed for a DAT file -->
                  <CheckBox x:Name="ChkDatRecursive"
                            Grid.Row="4"
                            Grid.Column="2"
                            Grid.ColumnSpan="3"
                            FontSize="11"
                            Content="{Binding I18n[tab1.chk_dat_recursive]}"
                            ToolTip.Tip="{Binding I18n[tab1.tooltip_dat_recursive]}"
                            ToolTip.ShowOnDisabled="True"
                            IsEnabled="{Binding Directories.IsDatFolder}"
                            IsChecked="{Binding Directories.DatRecursive, Mode=TwoWay}" />

                  <!-- Convention, and the one detected from the DAT or the names -->
                  <TextBlock Grid.Row="6" Classes="form-label" Text="{Binding I18n[tab1.lbl_convention]}" />
                  <StackPanel Grid.Row="6"
                              Grid.Column="2"
                              Grid.ColumnSpan="3"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <ComboBox x:Name="ComboConvention"
                              MinWidth="245"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_convention]}"
                              ItemsSource="{Binding Directories.NamingConventionOptions}"
                              SelectedValueBinding="{Binding Value}"
                              DisplayMemberBinding="{Binding Label}"
                              SelectedValue="{Binding Directories.SelectedNamingConvention, Mode=TwoWay}" />
                    <Border x:Name="LblConventionBadge"
                            MaxHeight="22"
                            CornerRadius="4"
                            Padding="8,1"
                            BorderThickness="1"
                            ToolTip.Tip="{Binding I18n[tab1.tooltip_convention_badge]}"
                            VerticalAlignment="Center">
                      <!-- Theme colors resolved with the theme variant, so that they follow a theme change -->
                      <Border.Background>
                        <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Badge*BackgroundBrush">
                          <Binding Path="Directories.ConventionBadgeTone" />
                          <Binding Path="$self.ActualThemeVariant" />
                        </MultiBinding>
                      </Border.Background>
                      <Border.BorderBrush>
                        <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Badge*BorderBrush">
                          <Binding Path="Directories.ConventionBadgeTone" />
                          <Binding Path="$self.ActualThemeVariant" />
                        </MultiBinding>
                      </Border.BorderBrush>
                      <TextBlock Text="{Binding Directories.ConventionBadgeText}"
                                 FontWeight="Bold"
                                 FontSize="11"
                                 VerticalAlignment="Center">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Badge*ForegroundBrush">
                            <Binding Path="Directories.ConventionBadgeTone" />
                            <Binding Path="$self.ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Optional files of a MAME collection, always shown so that they are known and a value kept from the last
                 MAME sort can be seen; in the colours of the MAME convention badge with the MAME convention, like the
                 MAME card of the Filters page, and otherwise with a sentence that says they are only read for MAME.
                 Each field says what it serves -->
            <Border x:Name="CardMameFiles"
                    Classes="settings-card"
                    Classes.mame="{Binding Directories.IsMameConvention}">
              <StackPanel Spacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="card-title">
                    <Run Text="{Binding I18n[tab1.card_mame_files]}" /> <Run Classes="optional" Text="{Binding I18n[tab1.optional_many]}" />
                  </TextBlock>
                  <TextBlock x:Name="LblMameFilesInactive"
                             Classes="form-hint"
                             IsVisible="{Binding !Directories.IsMameConvention}"
                             Text="{Binding I18n[tab1.hint_mame_files_inactive]}" />
                </StackPanel>
                <Grid RowDefinitions="Auto,2,Auto,8,Auto,2,Auto,8,Auto,2,Auto">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CollectionLabel" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- CHD folder, kept apart from the ROM sets -->
                  <TextBlock x:Name="LblChdDir" Grid.Row="0" Classes="form-label" Text="{Binding I18n[tab1.lbl_chd_dir]}" />
                  <TextBox x:Name="EditChdDir"
                           Grid.Row="0"
                           Grid.Column="2"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_chd_dir]}"
                           Watermark="{Binding I18n[tab1.edit_chd_dir_placeholder]}"
                           Text="{Binding Directories.ChdDir, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <Button x:Name="BtnClearChdDir"
                              Classes="field-clear"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_clear_chd_dir]}"
                              AutomationProperties.Name="{Binding I18n[tab1.tooltip_clear_chd_dir]}"
                              IsVisible="{Binding Directories.ChdDir, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Command="{Binding Directories.ClearChdDirCommand}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="BtnBrowseChdDir"
                          Grid.Row="0"
                          Grid.Column="4"
                          Content="{Binding I18n[tab1.btn_browse]}"
                          ToolTip.Tip="{Binding I18n[tab1.tooltip_chd_dir]}"
                          FontSize="11"
                          Command="{Binding Directories.BrowseChdDirCommand}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Classes="form-hint" Text="{Binding I18n[tab1.hint_chd_dir]}" />

                  <!-- Category file of the machines (catver.ini, catlist.ini) -->
                  <TextBlock x:Name="LblMameCategoryFile" Grid.Row="4" Classes="form-label" Text="{Binding I18n[tab1.lbl_mame_category_file]}" />
                  <TextBox x:Name="EditMameCategoryFile"
                           Grid.Row="4"
                           Grid.Column="2"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_mame_category_file]}"
                           Watermark="{Binding I18n[tab1.edit_mame_category_file_placeholder]}"
                           Text="{Binding Directories.MameCategoryFile, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <Button x:Name="BtnClearMameCategoryFile"
                              Classes="field-clear"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_clear_mame_category_file]}"
                              AutomationProperties.Name="{Binding I18n[tab1.tooltip_clear_mame_category_file]}"
                              IsVisible="{Binding Directories.MameCategoryFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Command="{Binding Directories.ClearMameCategoryFileCommand}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="BtnBrowseMameCategoryFile"
                          Grid.Row="4"
                          Grid.Column="4"
                          Content="{Binding I18n[tab1.btn_browse]}"
                          ToolTip.Tip="{Binding I18n[tab1.tooltip_mame_category_file]}"
                          FontSize="11"
                          Command="{Binding Directories.BrowseMameCategoryFileCommand}" />
                  <TextBlock Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" Classes="form-hint" Text="{Binding I18n[tab1.hint_mame_category_file]}" />

                  <!-- Rating file of the machines (bestgames.ini) -->
                  <TextBlock x:Name="LblMameRatingFile" Grid.Row="8" Classes="form-label" Text="{Binding I18n[tab1.lbl_mame_rating_file]}" />
                  <TextBox x:Name="EditMameRatingFile"
                           Grid.Row="8"
                           Grid.Column="2"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_mame_rating_file]}"
                           Watermark="{Binding I18n[tab1.edit_mame_rating_file_placeholder]}"
                           Text="{Binding Directories.MameRatingFile, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <Button x:Name="BtnClearMameRatingFile"
                              Classes="field-clear"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_clear_mame_rating_file]}"
                              AutomationProperties.Name="{Binding I18n[tab1.tooltip_clear_mame_rating_file]}"
                              IsVisible="{Binding Directories.MameRatingFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Command="{Binding Directories.ClearMameRatingFileCommand}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="BtnBrowseMameRatingFile"
                          Grid.Row="8"
                          Grid.Column="4"
                          Content="{Binding I18n[tab1.btn_browse]}"
                          ToolTip.Tip="{Binding I18n[tab1.tooltip_mame_rating_file]}"
                          FontSize="11"
                          Command="{Binding Directories.BrowseMameRatingFileCommand}" />
                  <TextBlock Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="3" Classes="form-hint" Text="{Binding I18n[tab1.hint_mame_rating_file]}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- =============================================================== -->
      <!-- STEP 2a: Filters, the options of one convention at a time       -->
      <!-- =============================================================== -->
      <Border x:Name="PageFilters" Classes="step-page" IsVisible="{Binding Navigation.IsFiltersShown}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid RowDefinitions="Auto,8,Auto,Auto" Margin="2">

            <!-- Convention whose options are shown: follows the effective convention, can be switched by hand -->
            <StackPanel x:Name="PanelFilterConvention"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="12">
              <TextBlock Text="{Binding I18n[filters.lbl_convention]}"
                         FontSize="11"
                         VerticalAlignment="Center" />
              <RadioButton x:Name="RadioFiltersTosec"
                           GroupName="FilterConvention"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[filters.tooltip_convention]}"
                           Content="{Binding I18n[filters.convention_tosec]}"
                           IsChecked="{Binding Filters.IsTosecShown, Mode=TwoWay}" />
              <RadioButton x:Name="RadioFiltersNoIntro"
                           GroupName="FilterConvention"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[filters.tooltip_convention]}"
                           Content="{Binding I18n[filters.convention_nointro]}"
                           IsChecked="{Binding Filters.IsNoIntroShown, Mode=TwoWay}" />
            </StackPanel>

            <!-- MAME machines: only with the MAME convention, whose sets use the No-Intro / Redump options. A card in
                 the colours of the MAME convention badge, above the shared options, as they matter most for MAME. The
                 machines to keep, the emulation and the complete sets stay in sight; the finer filters (cabinet,
                 controls, categories, ratings, size) open in drop-down panels from a row of buttons that each name
                 their restrictions, so that the card stays short -->
            <Border x:Name="GrpFilterMame"
                    Grid.Row="2"
                    Margin="0,0,0,12"
                    Classes="settings-card"
                    Classes.mame="{Binding Filters.AreMameOptionsShown}"
                    IsVisible="{Binding Filters.IsMameCardShown}">
              <StackPanel Spacing="2">
                <!-- The title and its hint share a line, the hint wrapping under it when the line is too short. Without
                     the MAME convention, the card is only this line, which says when it applies -->
                <TextBlock x:Name="LblFilterMame"
                           TextWrapping="Wrap">
                  <Run FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BadgeMameForegroundBrush}"
                       Text="{Binding I18n[filters.grp_mame]}" />
                  <Run Text="  " />
                  <Run FontSize="11"
                       Foreground="{DynamicResource HintForegroundBrush}"
                       Text="{Binding Filters.MameCardHint}" />
                </TextBlock>
                <!-- The options themselves, with the MAME convention only -->
                <StackPanel x:Name="PanelMameBody"
                            Spacing="2"
                            Margin="0,8,0,0"
                            IsVisible="{Binding Filters.AreMameOptionsShown}">
                  <Grid ColumnDefinitions="2*,24,*">

                    <!-- Machines to keep, on two columns -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                      <TextBlock Classes="section-title" Text="{Binding I18n[filters.grp_mame_keep]}" />
                      <Grid x:Name="GrpMameKeep" ColumnDefinitions="*,16,*" RowDefinitions="Auto,4,Auto,4,Auto,4,Auto">
                        <CheckBox x:Name="ChkKeepMameBios"
                                  Grid.Row="0" Grid.Column="0"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_bios]}"
                                  IsChecked="{Binding Filters.KeepMameBios, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_bios]}" />
                        </CheckBox>
                        <CheckBox x:Name="ChkKeepMameDevices"
                                  Grid.Row="2" Grid.Column="0"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_devices]}"
                                  IsChecked="{Binding Filters.KeepMameDevices, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_devices]}" />
                        </CheckBox>
                        <CheckBox x:Name="ChkKeepMameMechanical"
                                  Grid.Row="4" Grid.Column="0"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_mechanical]}"
                                  IsChecked="{Binding Filters.KeepMameMechanical, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_mechanical]}" />
                        </CheckBox>
                        <CheckBox x:Name="ChkKeepMameRequiresArtwork"
                                  Grid.Row="0" Grid.Column="2"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_requires_artwork]}"
                                  IsChecked="{Binding Filters.KeepMameRequiresArtwork, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_requires_artwork]}" />
                        </CheckBox>
                        <CheckBox x:Name="ChkKeepMameUnemulatedSound"
                                  Grid.Row="2" Grid.Column="2"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_unemulated_sound]}"
                                  IsChecked="{Binding Filters.KeepMameUnemulatedSound, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_unemulated_sound]}" />
                        </CheckBox>
                        <CheckBox x:Name="ChkKeepMameAlternateSets"
                                  Grid.Row="4" Grid.Column="2"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_alternate_sets]}"
                                  IsChecked="{Binding Filters.KeepMameAlternateSets, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_alternate_sets]}" />
                        </CheckBox>
                        <CheckBox x:Name="ChkKeepMameNothingToDump"
                                  Grid.Row="6" Grid.Column="0"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_nothing_to_dump]}"
                                  IsChecked="{Binding Filters.KeepMameNothingToDump, Mode=TwoWay}">
                          <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_nothing_to_dump]}" />
                        </CheckBox>
                      </Grid>
                    </StackPanel>

                    <!-- Emulation: the driver statuses kept, in a row, and the playable machines whatever their status;
                         under them, the complete sets option worded for MAME (ROMs and disks present) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                      <TextBlock Classes="section-title"
                                 Text="{Binding I18n[filters.grp_mame_emulation]}"
                                 ToolTip.Tip="{Binding I18n[filters.tooltip_mame_driver]}" />
                      <WrapPanel x:Name="GrpMameDriverStatuses" Orientation="Horizontal">
                        <WrapPanel.Styles>
                          <Style Selector="CheckBox">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Margin" Value="0,0,12,0" />
                          </Style>
                        </WrapPanel.Styles>
                        <CheckBox x:Name="ChkKeepMameDriverGood"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_mame_driver_good]}"
                                  IsChecked="{Binding Filters.KeepMameDriverGood, Mode=TwoWay}"
                                  Content="{Binding I18n[filters.chk_mame_driver_good]}" />
                        <CheckBox x:Name="ChkKeepMameDriverImperfect"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_mame_driver_imperfect]}"
                                  IsChecked="{Binding Filters.KeepMameDriverImperfect, Mode=TwoWay}"
                                  Content="{Binding I18n[filters.chk_mame_driver_imperfect]}" />
                        <CheckBox x:Name="ChkKeepMameDriverPreliminary"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_mame_driver_preliminary]}"
                                  IsChecked="{Binding Filters.KeepMameDriverPreliminary, Mode=TwoWay}"
                                  Content="{Binding I18n[filters.chk_mame_driver_preliminary]}" />
                      </WrapPanel>
                      <CheckBox x:Name="ChkMameKeepPlayable"
                                FontSize="11"
                                IsEnabled="{Binding Filters.IsMameKeepPlayableApplicable}"
                                ToolTip.ShowOnDisabled="True"
                                ToolTip.Tip="{Binding I18n[filters.tooltip_mame_keep_playable]}"
                                IsChecked="{Binding Filters.MameKeepPlayable, Mode=TwoWay}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_mame_keep_playable]}" />
                      </CheckBox>
                      <!-- No status kept, or the mechanical machines kept while none of the DAT has a status kept -->
                      <TextBlock x:Name="LblMameEmulationWarning"
                                 Margin="0,2,0,0"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource PatternWarningForegroundBrush}"
                                 IsVisible="{Binding Filters.HasEmulationWarning}"
                                 Text="{Binding Filters.EmulationWarningText}"
                                 ToolTip.Tip="{Binding Filters.EmulationWarningTooltip}" />
                      <CheckBox x:Name="ChkMameCompleteSetsOnly"
                                Margin="0,8,0,0"
                                FontSize="11"
                                ToolTip.Tip="{Binding I18n[filters.tooltip_mame_complete_sets]}"
                                IsChecked="{Binding Filters.CompleteSetsOnly, Mode=TwoWay}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_mame_complete_sets_only]}" />
                      </CheckBox>
                    </StackPanel>
                  </Grid>

                  <!-- Finer filters, each in a drop-down panel that opens over the page. A button names its only
                       restriction or counts them, and is emphasized while it excludes machines -->
                  <TextBlock Classes="section-title" Margin="2,10,0,4" Text="{Binding I18n[filters.grp_mame_refine]}" />
                  <WrapPanel x:Name="PanelMameRefine" Orientation="Horizontal">
                    <WrapPanel.Styles>
                      <Style Selector="DropDownButton">
                        <Setter Property="Margin" Value="0,0,8,4" />
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="FontSize" Value="11" />
                      </Style>
                    </WrapPanel.Styles>

                    <!-- Cabinet: screen, players and buttons, as -listxml describes them (never a reason to exclude a
                         machine whose DAT does not say) -->
                    <DropDownButton x:Name="BtnMameCabinet"
                                    Classes="advanced-options"
                                    Classes.changed="{Binding Filters.Cabinet.IsCabinetRestricted}"
                                    Content="{Binding Filters.Cabinet.SummaryText}"
                                    ToolTip.Tip="{Binding Filters.Cabinet.SummaryTooltip}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="PanelMameCabinet" Spacing="4" MinWidth="240">
                            <TextBlock Classes="section-title" Text="{Binding I18n[filters.grp_mame_screen]}" />
                            <ComboBox x:Name="ComboMameOrientation"
                                      FontSize="11"
                                      MinWidth="180"
                                      ToolTip.Tip="{Binding I18n[filters.tooltip_mame_orientation]}"
                                      ItemsSource="{Binding Filters.Cabinet.OrientationOptions}"
                                      SelectedValueBinding="{Binding Value}"
                                      DisplayMemberBinding="{Binding Label}"
                                      SelectedValue="{Binding Filters.Cabinet.Orientation, Mode=TwoWay}" />
                            <CheckBox x:Name="ChkKeepMameVector"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_vector]}"
                                      Content="{Binding I18n[filters.chk_keep_mame_vector]}"
                                      IsChecked="{Binding Filters.Cabinet.KeepVector, Mode=TwoWay}" />
                            <CheckBox x:Name="ChkKeepMameLcd"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_lcd]}"
                                      Content="{Binding I18n[filters.chk_keep_mame_lcd]}"
                                      IsChecked="{Binding Filters.Cabinet.KeepLcd, Mode=TwoWay}" />
                            <TextBlock Classes="section-title" Margin="2,8,0,4" Text="{Binding I18n[filters.grp_mame_players]}" />
                            <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,6,Auto">
                              <TextBlock Grid.Row="0" Grid.Column="0"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         Text="{Binding I18n[filters.lbl_mame_players]}" />
                              <ComboBox x:Name="ComboMamePlayers"
                                        Grid.Row="0" Grid.Column="2"
                                        FontSize="11"
                                        MinWidth="120"
                                        ToolTip.Tip="{Binding I18n[filters.tooltip_mame_players]}"
                                        ItemsSource="{Binding Filters.Cabinet.PlayerOptions}"
                                        SelectedValueBinding="{Binding Value}"
                                        DisplayMemberBinding="{Binding Label}"
                                        SelectedValue="{Binding Filters.Cabinet.MinimumPlayers, Mode=TwoWay}" />
                              <TextBlock Grid.Row="2" Grid.Column="0"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         Text="{Binding I18n[filters.lbl_mame_buttons]}" />
                              <ComboBox x:Name="ComboMameButtons"
                                        Grid.Row="2" Grid.Column="2"
                                        FontSize="11"
                                        MinWidth="120"
                                        ToolTip.Tip="{Binding I18n[filters.tooltip_mame_buttons]}"
                                        ItemsSource="{Binding Filters.Cabinet.ButtonOptions}"
                                        SelectedValueBinding="{Binding Value}"
                                        DisplayMemberBinding="{Binding Label}"
                                        SelectedValue="{Binding Filters.Cabinet.MaximumButtons, Mode=TwoWay}" />
                            </Grid>
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Controls the panel has: nine kinds -->
                    <DropDownButton x:Name="BtnMameControls"
                                    Classes="advanced-options"
                                    Classes.changed="{Binding Filters.Cabinet.AreControlsRestricted}"
                                    Content="{Binding Filters.Cabinet.ControlsText}"
                                    ToolTip.Tip="{Binding Filters.Cabinet.ControlsTooltip}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="PanelMameControls" Spacing="4">
                            <TextBlock x:Name="LblMameControlsHint"
                                       FontSize="11"
                                       MaxWidth="320"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HintForegroundBrush}"
                                       Text="{Binding I18n[filters.mame_controls_hint]}" />
                            <ItemsControl x:Name="ListMameControls" ItemsSource="{Binding Filters.Cabinet.Controls}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MameControlOptionViewModel">
                                  <CheckBox FontSize="11"
                                            Margin="0,2"
                                            Content="{Binding Label}"
                                            ToolTip.Tip="{Binding Tooltip}"
                                            IsChecked="{Binding IsAvailable, Mode=TwoWay}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Categories of the category file (catver.ini, catlist.ini) chosen in the Collection step: adults,
                         arcade, and the genres (about sixty in a full file) -->
                    <DropDownButton x:Name="BtnMameCategories"
                                    Classes="advanced-options"
                                    Classes.changed="{Binding Filters.Categories.IsRestricted}"
                                    IsEnabled="{Binding Filters.Categories.IsAvailable}"
                                    Content="{Binding Filters.Categories.SummaryText}"
                                    ToolTip.Tip="{Binding Filters.Categories.SummaryTooltip}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="PanelMameCategories" Spacing="4" MaxWidth="340">
                            <TextBlock x:Name="LblMameCategoriesStatus"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HintForegroundBrush}"
                                       Margin="0,0,0,4"
                                       Text="{Binding Filters.Categories.StatusText}" />
                            <CheckBox x:Name="ChkKeepMameMature"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_mature]}"
                                      ToolTip.ShowOnDisabled="True"
                                      IsEnabled="{Binding Filters.Categories.HasCategories}"
                                      IsChecked="{Binding Filters.Categories.KeepMature, Mode=TwoWay}">
                              <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_mature]}" />
                            </CheckBox>
                            <CheckBox x:Name="ChkKeepMameNonArcade"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_non_arcade]}"
                                      ToolTip.ShowOnDisabled="True"
                                      IsEnabled="{Binding Filters.Categories.IsArcadeFilterAvailable}"
                                      IsChecked="{Binding Filters.Categories.KeepNonArcade, Mode=TwoWay}">
                              <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_non_arcade]}" />
                            </CheckBox>
                            <!-- Why the arcade filter is greyed out: catver.ini does not mark the arcade machines -->
                            <TextBlock x:Name="LblMameArcadeFilterMissing"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HintForegroundBrush}"
                                       Margin="0,0,0,2"
                                       IsVisible="{Binding Filters.Categories.IsArcadeFilterMissing}"
                                       Text="{Binding I18n[filters.mame_arcade_filter_missing]}" />
                            <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding Filters.Categories.HasGenres}">
                              <TextBlock x:Name="LblMameGenres"
                                         Classes="section-title"
                                         ToolTip.Tip="{Binding Filters.Categories.GenresTooltip}">
                                <Run Text="{Binding I18n[filters.grp_mame_genres]}" /><Run Text=" · " /><Run Text="{Binding Filters.Categories.GenresText, Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock x:Name="LblMameGenresHint"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource HintForegroundBrush}"
                                         Text="{Binding I18n[filters.mame_genres_hint]}" />
                              <!-- To keep only a few genres: uncheck them all, then check those to keep -->
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="BtnMameGenresKeepAll"
                                        Classes="secondary-action"
                                        FontSize="11"
                                        Padding="10,2"
                                        MinHeight="24"
                                        ToolTip.Tip="{Binding I18n[filters.tooltip_mame_genres_keep_all]}"
                                        Command="{Binding Filters.Categories.KeepAllGenresCommand}"
                                        Content="{Binding I18n[filters.btn_mame_genres_keep_all]}" />
                                <Button x:Name="BtnMameGenresExcludeAll"
                                        Classes="secondary-action"
                                        FontSize="11"
                                        Padding="10,2"
                                        MinHeight="24"
                                        ToolTip.Tip="{Binding I18n[filters.tooltip_mame_genres_exclude_all]}"
                                        Command="{Binding Filters.Categories.ExcludeAllGenresCommand}"
                                        Content="{Binding I18n[filters.btn_mame_genres_exclude_all]}" />
                              </StackPanel>
                              <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ListMameGenres" ItemsSource="{Binding Filters.Categories.Genres}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MameGenreOptionViewModel">
                                      <CheckBox FontSize="11"
                                                Margin="0,2"
                                                Content="{Binding Name}"
                                                IsChecked="{Binding IsKept, Mode=TwoWay}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </StackPanel>
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Ratings of the rating file (bestgames.ini) chosen in the Collection step -->
                    <DropDownButton x:Name="BtnMameRatings"
                                    Classes="advanced-options"
                                    Classes.changed="{Binding Filters.Ratings.IsRatingRestricted}"
                                    IsEnabled="{Binding Filters.Ratings.HasRatings}"
                                    Content="{Binding Filters.Ratings.RatingsText}"
                                    ToolTip.Tip="{Binding Filters.Ratings.RatingsTooltip}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="PanelMameRatings" Spacing="4" MaxWidth="340">
                            <TextBlock x:Name="LblMameRatingsStatus"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HintForegroundBrush}"
                                       Margin="0,0,0,4"
                                       Text="{Binding Filters.Ratings.StatusText}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock FontSize="11"
                                         VerticalAlignment="Center"
                                         Text="{Binding I18n[filters.lbl_mame_minimum_rating]}" />
                              <ComboBox x:Name="ComboMameMinimumRating"
                                        FontSize="11"
                                        MinWidth="120"
                                        ToolTip.Tip="{Binding I18n[filters.tooltip_mame_minimum_rating]}"
                                        IsEnabled="{Binding Filters.Ratings.HasRatings}"
                                        ItemsSource="{Binding Filters.Ratings.RatingOptions}"
                                        SelectedValueBinding="{Binding Value}"
                                        DisplayMemberBinding="{Binding Label}"
                                        SelectedValue="{Binding Filters.Ratings.MinimumRating, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox x:Name="ChkKeepMameUnrated"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[filters.tooltip_keep_mame_unrated]}"
                                      IsEnabled="{Binding Filters.Ratings.HasRatings}"
                                      IsChecked="{Binding Filters.Ratings.KeepUnrated, Mode=TwoWay}">
                              <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_keep_mame_unrated]}" />
                            </CheckBox>
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Size budget of the kept sets, the best rated first -->
                    <DropDownButton x:Name="BtnMameBudget"
                                    Classes="advanced-options"
                                    Classes.changed="{Binding Filters.Ratings.IsBudgetEnabled}"
                                    Content="{Binding Filters.Ratings.BudgetText}"
                                    ToolTip.Tip="{Binding I18n[filters.tooltip_mame_budget]}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel x:Name="PanelMameBudget" Spacing="6" MaxWidth="340">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <CheckBox x:Name="ChkMameBudget"
                                        FontSize="11"
                                        ToolTip.Tip="{Binding I18n[filters.tooltip_mame_budget]}"
                                        IsChecked="{Binding Filters.Ratings.IsBudgetEnabled, Mode=TwoWay}"
                                        Content="{Binding I18n[filters.chk_mame_budget]}" />
                              <NumericUpDown x:Name="NumMameBudget"
                                             FontSize="11"
                                             Width="80"
                                             MinHeight="24"
                                             Padding="6,2"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             ShowButtonSpinner="False"
                                             Minimum="0.1"
                                             Maximum="100000"
                                             Increment="1"
                                             FormatString="0.##"
                                             ToolTip.Tip="{Binding I18n[filters.tooltip_mame_budget]}"
                                             IsEnabled="{Binding Filters.Ratings.IsBudgetEnabled}"
                                             Value="{Binding Filters.Ratings.BudgetGb, Mode=TwoWay}" />
                              <TextBlock FontSize="11"
                                         VerticalAlignment="Center"
                                         Text="{Binding I18n[filters.unit_gb]}" />
                            </StackPanel>
                            <TextBlock x:Name="LblMameBudgetHint"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource HintForegroundBrush}"
                                       Text="{Binding I18n[filters.mame_budget_hint]}" />
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,16,1.3*,16,*"
                  Classes.mame="{Binding Filters.AreMameOptionsShown}">
              <!-- With the MAME options, the dump quality is greyed (it never applies to a set) and the multi-disc group
                   is hidden (its complete sets option is in the MAME card): the content to keep takes the room of both,
                   its boxes on rows rather than in a column. These are styles: a local value would win over the MAME
                   style -->
              <Grid.Styles>
                <Style Selector="StackPanel#ColFilterContent">
                  <Setter Property="Grid.Column" Value="2" />
                </Style>
                <Style Selector="Grid.mame > StackPanel#ColFilterContent">
                  <Setter Property="Grid.ColumnSpan" Value="3" />
                </Style>
                <Style Selector="WrapPanel#GrpFilterContent">
                  <Setter Property="Orientation" Value="Vertical" />
                </Style>
                <Style Selector="Grid.mame WrapPanel#GrpFilterContent">
                  <Setter Property="Orientation" Value="Horizontal" />
                </Style>
                <Style Selector="WrapPanel#GrpFilterContent > CheckBox">
                  <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
                <Style Selector="Grid.mame WrapPanel#GrpFilterContent > CheckBox">
                  <Setter Property="Margin" Value="0,0,24,4" />
                </Style>
              </Grid.Styles>

              <!-- Column 1: dump quality, a single level; the exclusions one by one in a drop-down panel. Greyed with the
                   MAME options, a sentence saying why -->
              <StackPanel x:Name="ColFilterDumps"
                          Grid.Column="0"
                          VerticalAlignment="Top">
                <TextBlock Classes="section-title" Text="{Binding I18n[filters.grp_dumps]}" />
                <TextBlock x:Name="LblDumpsNoEffect"
                           Classes="form-hint"
                           Margin="2,-2,0,6"
                           IsVisible="{Binding !Filters.IsDumpQualityApplicable}"
                           Text="{Binding Filters.DumpsNoEffectText}" />
                <StackPanel x:Name="GrpDumpQuality" Spacing="4" IsEnabled="{Binding Filters.IsDumpQualityApplicable}">
                  <RadioButton x:Name="RadioDumpLevelAll"
                               GroupName="DumpLevel"
                               FontSize="11"
                               ToolTip.Tip="{Binding I18n[filters.tooltip_level_all]}"
                               Content="{Binding I18n[filters.level_all]}"
                               IsChecked="{Binding Filters.IsDumpLevelAll, Mode=TwoWay}" />
                  <RadioButton x:Name="RadioDumpLevelNoBad"
                               GroupName="DumpLevel"
                               FontSize="11"
                               ToolTip.Tip="{Binding I18n[filters.tooltip_level_no_bad]}"
                               Content="{Binding I18n[filters.level_no_bad]}"
                               IsChecked="{Binding Filters.IsDumpLevelNoBadDumps, Mode=TwoWay}" />
                  <!-- Not offered for No-Intro / Redump, whose names never mark a verified dump -->
                  <RadioButton x:Name="RadioDumpLevelVerified"
                               GroupName="DumpLevel"
                               FontSize="11"
                               IsVisible="{Binding Filters.IsDumpLevelVerifiedOnlyShown}"
                               ToolTip.Tip="{Binding I18n[tab2.tooltip_verified_only]}"
                               IsChecked="{Binding Filters.IsDumpLevelVerifiedOnly, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap">
                      <Run Text="{Binding I18n[filters.level_verified]}" /> <Run Text="{Binding I18n[filters.tag_tosec_verified]}" Classes="tag" />
                    </TextBlock>
                  </RadioButton>
                  <!-- Fourth choice, only shown (and checked) when the exclusions match no level: the group always has
                       a checked choice. It cannot be chosen by hand: the exclusions are set in the detail below -->
                  <RadioButton x:Name="RadioDumpLevelCustom"
                               GroupName="DumpLevel"
                               FontSize="11"
                               ToolTip.Tip="{Binding I18n[filters.tooltip_level_custom]}"
                               Content="{Binding I18n[filters.level_custom]}"
                               IsVisible="{Binding Filters.IsDumpLevelCustom}"
                               IsChecked="{Binding Filters.IsDumpLevelCustom, Mode=OneWay}" />
                  <DropDownButton x:Name="BtnDumpDetails"
                                  HorizontalAlignment="Left"
                                  MinHeight="24"
                                  Padding="10,2"
                                  FontSize="11"
                                  Content="{Binding I18n[filters.btn_dump_details]}"
                                  ToolTip.Tip="{Binding I18n[filters.tooltip_dump_details]}">
                    <DropDownButton.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel x:Name="PanelDumpDetails" Spacing="4">
                          <StackPanel Spacing="4" IsVisible="{Binding Filters.IsTosecShown}">
                            <CheckBox x:Name="ChkExcludeBad"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab2.tooltip_exclude_bad]}"
                                      IsEnabled="{Binding TosecFilters.AreSubDumpFiltersEnabled}"
                                      IsChecked="{Binding TosecFilters.ExcludeBadDumps, Mode=TwoWay}">
                              <TextBlock><Run Text="{Binding I18n[filters.chk_exclude_bad]}" /> <Run Text="{Binding I18n[filters.tag_bad]}" Classes="tag" /></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="ChkExcludeOverUnder"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab2.tooltip_exclude_over_under]}"
                                      IsEnabled="{Binding TosecFilters.AreSubDumpFiltersEnabled}"
                                      IsChecked="{Binding TosecFilters.ExcludeOverUnder, Mode=TwoWay}">
                              <TextBlock><Run Text="{Binding I18n[filters.chk_exclude_over_under]}" /> <Run Text="{Binding I18n[filters.tag_over_under]}" Classes="tag" /></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="ChkExcludeVirus"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab2.tooltip_exclude_virus]}"
                                      IsEnabled="{Binding TosecFilters.AreSubDumpFiltersEnabled}"
                                      IsChecked="{Binding TosecFilters.ExcludeVirus, Mode=TwoWay}">
                              <TextBlock><Run Text="{Binding I18n[filters.chk_exclude_virus]}" /> <Run Text="{Binding I18n[filters.tag_virus]}" Classes="tag" /></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="ChkExcludeAlt"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab2.tooltip_exclude_alt]}"
                                      IsEnabled="{Binding TosecFilters.AreSubDumpFiltersEnabled}"
                                      IsChecked="{Binding TosecFilters.ExcludeAlternate, Mode=TwoWay}">
                              <TextBlock><Run Text="{Binding I18n[filters.chk_exclude_alt]}" /> <Run Text="{Binding I18n[filters.tag_tosec_alt]}" Classes="tag" /></TextBlock>
                            </CheckBox>
                          </StackPanel>
                          <StackPanel Spacing="4" IsVisible="{Binding Filters.IsNoIntroShown}">
                            <CheckBox x:Name="ChkNoIntroExcludeBad"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab2.tooltip_nointro_exclude_bad]}"
                                      IsChecked="{Binding NoIntroFilters.ExcludeBadDumps, Mode=TwoWay}">
                              <TextBlock><Run Text="{Binding I18n[filters.chk_exclude_bad]}" /> <Run Text="{Binding I18n[filters.tag_bad]}" Classes="tag" /></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="ChkNoIntroExcludeAlt"
                                      FontSize="11"
                                      ToolTip.Tip="{Binding I18n[tab2.tooltip_nointro_exclude_alt]}"
                                      IsChecked="{Binding NoIntroFilters.ExcludeAlternate, Mode=TwoWay}">
                              <TextBlock><Run Text="{Binding I18n[filters.chk_exclude_alt]}" /> <Run Text="{Binding I18n[filters.tag_nointro_alt]}" Classes="tag" /></TextBlock>
                            </CheckBox>
                          </StackPanel>
                        </StackPanel>
                      </Flyout>
                    </DropDownButton.Flyout>
                  </DropDownButton>
                </StackPanel>
              </StackPanel>

              <!-- Column 2: content to keep, worded positively: a checked box keeps its category, the opposite of its
                   exclude_* option. The shared categories act on the shown convention, whose tag follows them -->
              <StackPanel x:Name="ColFilterContent" VerticalAlignment="Top">
                <TextBlock x:Name="LblFilterContent"
                           Classes="section-title"
                           Text="{Binding I18n[filters.grp_content]}"
                           ToolTip.Tip="{Binding I18n[filters.tooltip_content]}" />
                <!-- The No-Intro / Redump content options also apply to the MAME sets: changing one for a collection
                     changes the others, whereas the TOSEC options are their own -->
                <TextBlock x:Name="LblFilterContentShared"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,-2,0,6"
                           Foreground="{DynamicResource HintForegroundBrush}"
                           IsVisible="{Binding Filters.IsNoIntroShown}"
                           Text="{Binding I18n[filters.content_shared_hint]}" />
                <WrapPanel x:Name="GrpFilterContent">
                  <CheckBox x:Name="ChkKeepModifications"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.ModificationsTooltip}"
                            IsChecked="{Binding Filters.KeepModifications, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_modifications]}" /> <Run Text="{Binding Filters.ModificationsTag}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepPirate"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.PirateTooltip}"
                            IsVisible="{Binding Filters.IsNoIntroShown}"
                            IsChecked="{Binding Filters.KeepPirate, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_pirate]}" /> <Run Text="{Binding Filters.PirateTag}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepTranslations"
                            FontSize="11"
                            IsEnabled="{Binding Filters.AreTranslationsApplicable}"
                            ToolTip.ShowOnDisabled="True"
                            ToolTip.Tip="{Binding Filters.TranslationsTooltip}"
                            IsChecked="{Binding Filters.KeepTranslations, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_translations]}" /> <Run Text="{Binding Filters.TranslationsTag}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepDev"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.DevVersionsTooltip}"
                            IsChecked="{Binding Filters.KeepDevVersions, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_dev]}" /> <Run Text="{Binding Filters.DevVersionsTag}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepDemos"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.DemosTooltip}"
                            IsChecked="{Binding Filters.KeepDemos, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_demos]}" /> <Run Text="{Binding Filters.DemosTag}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepPd"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[filters.tooltip_keep_tosec_pd]}"
                            IsVisible="{Binding Filters.IsTosecShown}"
                            IsChecked="{Binding Filters.KeepPublicDomain, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_pd]}" /> <Run Text="{Binding I18n[filters.tag_tosec_pd]}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepUnl"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.UnlicensedTooltip}"
                            ToolTip.ShowOnDisabled="True"
                            IsVisible="{Binding Filters.IsNoIntroShown}"
                            IsEnabled="{Binding Filters.AreNoIntroOnlyOptionsApplicable}"
                            IsChecked="{Binding Filters.KeepUnlicensed, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_unl]}" /> <Run Text="{Binding I18n[filters.tag_nointro_unl]}" Classes="tag" /></TextBlock>
                  </CheckBox>
                  <CheckBox x:Name="ChkKeepRereleases"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.RereleasesTooltip}"
                            ToolTip.ShowOnDisabled="True"
                            IsVisible="{Binding Filters.IsNoIntroShown}"
                            IsEnabled="{Binding Filters.AreNoIntroOnlyOptionsApplicable}"
                            IsChecked="{Binding Filters.KeepRereleases, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding I18n[filters.chk_keep_rereleases]}" /> <Run Text="{Binding I18n[filters.tag_nointro_rereleases]}" Classes="tag" /></TextBlock>
                  </CheckBox>
                </WrapPanel>
              </StackPanel>

              <!-- Column 3: multi-disc sets; with the MAME options, its complete sets option is in the MAME card -->
              <StackPanel x:Name="ColFilterMultidisk"
                          Grid.Column="4"
                          VerticalAlignment="Top"
                          IsVisible="{Binding Filters.IsMultidiskGroupShown}">
                <TextBlock Classes="section-title" Text="{Binding I18n[filters.grp_multidisk]}" />
                <StackPanel x:Name="GrpFilterMultidisk" Spacing="4">
                  <CheckBox x:Name="ChkCompleteSetsOnly"
                            FontSize="11"
                            ToolTip.Tip="{Binding Filters.CompleteSetsTooltip}"
                            IsChecked="{Binding Filters.CompleteSetsOnly, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding I18n[filters.chk_complete_sets_only]}" />
                  </CheckBox>
                  <CheckBox x:Name="ChkSmartMultidisk"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[tab2.tooltip_smart_multidisk]}"
                            IsVisible="{Binding Filters.IsTosecShown}"
                            IsChecked="{Binding TosecFilters.SmartMultidiskGrouping, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab2.chk_smart_multidisk]}" />
                  </CheckBox>
                </StackPanel>

                <!-- Amiga the collection is sorted for, from the chipset of the TOSEC names: a TOSEC option -->
                <StackPanel x:Name="GrpFilterAmiga"
                            Margin="0,12,0,0"
                            Spacing="4"
                            IsVisible="{Binding Filters.IsTosecShown}">
                  <TextBlock Classes="section-title" Text="{Binding I18n[filters.grp_amiga]}" />
                  <ComboBox x:Name="ComboAmigaTarget"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Binding I18n[filters.tooltip_amiga_target]}"
                            ItemsSource="{Binding TosecFilters.AmigaTargetOptions}"
                            SelectedValueBinding="{Binding Value}"
                            DisplayMemberBinding="{Binding Label}"
                            SelectedValue="{Binding TosecFilters.AmigaTarget, Mode=TwoWay}" />
                  <TextBlock x:Name="LblAmigaTargetHint"
                             Classes="form-hint"
                             TextWrapping="Wrap"
                             Text="{Binding TosecFilters.AmigaTargetHint}" />
                </StackPanel>
              </StackPanel>

            </Grid>
          </Grid>
        </ScrollViewer>
      </Border>

      <!-- =============================================================== -->
      <!-- STEP 2b: Languages, regions and 1G1R, in the order of the       -->
      <!-- reasoning: a profile to start from, the priority languages and  -->
      <!-- countries (their chips take the height left and scroll by       -->
      <!-- themselves), then how one version per game is chosen            -->
      <!-- =============================================================== -->
      <Border x:Name="PageLanguages" Classes="step-page" IsVisible="{Binding Navigation.IsLanguagesShown}">
        <Grid RowDefinitions="Auto,12,*,12,Auto" Margin="4,2">
          <Grid.Styles>
            <!-- A label does not grey out by itself: those of the 1G1R form follow their greyed-out settings -->
            <Style Selector="Grid#Grp1G1ROptions:disabled TextBlock.form-label, Grid#Grp1G1ROptions:disabled TextBlock.section-title, Grid#Grp1G1ROptions:disabled TextBlock.form-hint">
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </Style>
            <Style Selector="Button.preset">
              <Setter Property="FontSize" Value="11" />
              <Setter Property="Padding" Value="10,2" />
              <Setter Property="MinHeight" Value="24" />
              <Setter Property="Margin" Value="0,0,6,0" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </Grid.Styles>

          <!-- Profiles to start from: they replace the languages, the countries and the 1G1R settings -->
          <WrapPanel x:Name="PanelPresets" Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{Binding I18n[tab3.lbl_presets]}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Button x:Name="BtnPresetFr"
                    Classes="preset"
                    Content="{Binding I18n[tab3.btn_preset_france]}"
                    ToolTip.Tip="{Binding I18n[tab3.tooltip_preset_france]}"
                    Command="{Binding Priorities.Apply1G1RPresetCommand}"
                    CommandParameter="france" />
            <Button x:Name="BtnPresetEu"
                    Classes="preset"
                    Content="{Binding I18n[tab3.btn_preset_europe]}"
                    ToolTip.Tip="{Binding I18n[tab3.tooltip_preset_europe]}"
                    Command="{Binding Priorities.Apply1G1RPresetCommand}"
                    CommandParameter="europe" />
            <Button x:Name="BtnPresetUs"
                    Classes="preset"
                    Content="{Binding I18n[tab3.btn_preset_usa]}"
                    ToolTip.Tip="{Binding I18n[tab3.tooltip_preset_usa]}"
                    Command="{Binding Priorities.Apply1G1RPresetCommand}"
                    CommandParameter="usa" />
            <Button x:Name="BtnPresetJp"
                    Classes="preset"
                    Content="{Binding I18n[tab3.btn_preset_japan]}"
                    ToolTip.Tip="{Binding I18n[tab3.tooltip_preset_japan]}"
                    Command="{Binding Priorities.Apply1G1RPresetCommand}"
                    CommandParameter="japan" />
            <TextBlock x:Name="LblPresetsHint"
                       FontSize="11"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource HintForegroundBrush}"
                       Text="{Binding I18n[tab3.presets_hint]}" />
          </WrapPanel>

          <!-- Priority languages (left) and countries and regions (right): the chips take the height left -->
          <Grid Grid.Row="2" ColumnDefinitions="*,16,*">

            <Border x:Name="CardLanguages" Grid.Column="0" Classes="settings-card">
              <Grid RowDefinitions="Auto,8,*,8,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto">
                  <TextBlock x:Name="LblGrpLangsTitle"
                             Classes="card-title"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Priorities.GroupLanguagesTitle}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding Priorities.LanguagePriority.IsEnabled}">
                    <DropDownButton x:Name="BtnAddLanguage"
                                    MinHeight="24"
                                    Padding="10,2"
                                    FontSize="11"
                                    Content="{Binding I18n[chips.btn_add_language]}"
                                    ToolTip.Tip="{Binding I18n[chips.tooltip_add_language]}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <StackPanel x:Name="PanelAddLanguage" Width="280" Spacing="4">
                            <TextBox x:Name="EditLangSearch"
                                     FontSize="11"
                                     ToolTip.Tip="{Binding I18n[widget.tooltip_lang_search]}"
                                     Watermark="{Binding I18n[dialog.filter_placeholder]}"
                                     Text="{Binding Priorities.LanguagePriority.SearchFilterText, Mode=TwoWay}">
                              <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding Priorities.LanguagePriority.AddFirstMatchCommand}" />
                              </TextBox.KeyBindings>
                            </TextBox>
                            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                              <ItemsControl x:Name="ListAvailableLanguages"
                                            ItemsSource="{Binding Priorities.LanguagePriority.FilteredAvailableItems}"
                                            ItemTemplate="{StaticResource AvailablePriorityItemTemplate}" />
                            </ScrollViewer>
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="BtnLangReset"
                            Width="24"
                            Height="24"
                            MinHeight="24"
                            Padding="0"
                            FontSize="13"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="↺"
                            ToolTip.Tip="{Binding I18n[widget.tooltip_reset_default]}"
                            AutomationProperties.Name="{Binding I18n[widget.tooltip_reset_default]}"
                            Command="{Binding Priorities.LanguagePriority.ResetDefaultsCommand}" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChipsLanguages"
                                  VerticalAlignment="Top"
                                  IsEnabled="{Binding Priorities.LanguagePriority.IsEnabled}"
                                  ItemsSource="{Binding Priorities.LanguagePriority.PriorityItems}"
                                  ItemTemplate="{StaticResource PriorityChipTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                  <!-- Without any language, the middle of the card says how to add some -->
                  <TextBlock x:Name="LblLanguagesEmpty"
                             FontSize="11"
                             FontStyle="Italic"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource HintForegroundBrush}"
                             Text="{Binding I18n[chips.empty_languages]}"
                             IsVisible="{Binding !Priorities.LanguagePriority.HasPriorityItems}" />
                </Grid>

                <!-- The strict filter, and under it, indented, the games it would leave without any version -->
                <StackPanel x:Name="GrpLangs" Grid.Row="4" Spacing="2">
                  <CheckBox x:Name="ChkFilterLanguages"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[tab3.tooltip_filter_languages]}"
                            IsChecked="{Binding Priorities.FilterLanguages, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab3.chk_filter_languages]}" />
                  </CheckBox>
                  <CheckBox x:Name="ChkPriorityFallback"
                            Margin="28,0,0,0"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[tab3.tooltip_priority_fallback]}"
                            IsEnabled="{Binding Priorities.IsFallbackLanguagesEnabled}"
                            IsChecked="{Binding Priorities.FallbackUnmatchedLanguages, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab3.chk_priority_fallback]}" />
                  </CheckBox>
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="CardCountries" Grid.Column="2" Classes="settings-card">
              <Grid RowDefinitions="Auto,8,*,8,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto">
                  <TextBlock x:Name="LblGrpCountriesTitle"
                             Classes="card-title"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Priorities.GroupCountriesTitle}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding Priorities.CountryPriority.IsEnabled}">
                    <DropDownButton x:Name="BtnAddCountry"
                                    MinHeight="24"
                                    Padding="10,2"
                                    FontSize="11"
                                    Content="{Binding I18n[chips.btn_add_country]}"
                                    ToolTip.Tip="{Binding I18n[chips.tooltip_add_country]}">
                      <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <StackPanel x:Name="PanelAddCountry" Width="280" Spacing="4">
                            <TextBox x:Name="EditCountrySearch"
                                     FontSize="11"
                                     ToolTip.Tip="{Binding I18n[widget.tooltip_country_search]}"
                                     Watermark="{Binding I18n[dialog.filter_placeholder]}"
                                     Text="{Binding Priorities.CountryPriority.SearchFilterText, Mode=TwoWay}">
                              <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding Priorities.CountryPriority.AddFirstMatchCommand}" />
                              </TextBox.KeyBindings>
                            </TextBox>
                            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                              <ItemsControl x:Name="ListAvailableCountries"
                                            ItemsSource="{Binding Priorities.CountryPriority.FilteredAvailableItems}"
                                            ItemTemplate="{StaticResource AvailablePriorityItemTemplate}" />
                            </ScrollViewer>
                          </StackPanel>
                        </Flyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="BtnCountryReset"
                            Width="24"
                            Height="24"
                            MinHeight="24"
                            Padding="0"
                            FontSize="13"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="↺"
                            ToolTip.Tip="{Binding I18n[widget.tooltip_country_reset_default]}"
                            AutomationProperties.Name="{Binding I18n[widget.tooltip_country_reset_default]}"
                            Command="{Binding Priorities.CountryPriority.ResetDefaultsCommand}" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChipsCountries"
                                  VerticalAlignment="Top"
                                  IsEnabled="{Binding Priorities.CountryPriority.IsEnabled}"
                                  ItemsSource="{Binding Priorities.CountryPriority.PriorityItems}"
                                  ItemTemplate="{StaticResource PriorityChipTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock x:Name="LblCountriesEmpty"
                             FontSize="11"
                             FontStyle="Italic"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource HintForegroundBrush}"
                             Text="{Binding I18n[chips.empty_countries]}"
                             IsVisible="{Binding !Priorities.CountryPriority.HasPriorityItems}" />
                </Grid>

                <StackPanel x:Name="GrpCountries" Grid.Row="4" Spacing="2">
                  <CheckBox x:Name="ChkFilterCountries"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[tab3.tooltip_filter_countries]}"
                            IsChecked="{Binding Priorities.FilterCountries, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab3.chk_filter_countries]}" />
                  </CheckBox>
                  <CheckBox x:Name="ChkCountryFallback"
                            Margin="28,0,0,0"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[tab3.tooltip_country_fallback]}"
                            IsEnabled="{Binding Priorities.IsFallbackCountriesEnabled}"
                            IsChecked="{Binding Priorities.FallbackUnmatchedCountries, Mode=TwoWay}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab3.chk_country_fallback]}" />
                  </CheckBox>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- One version per game: the box in the title turns it on. Its settings always stay in sight, greyed out while
               it is off, so that the page never changes its layout and shows what the 1G1R offers -->
          <Border x:Name="Card1G1R" Grid.Row="4" Classes="settings-card">
            <StackPanel Spacing="2">
              <CheckBox x:Name="ChkOneGameOneRom"
                        ToolTip.Tip="{Binding I18n[tab3.tooltip_one_game_one_rom]}"
                        IsChecked="{Binding Priorities.OneGameOneRom, Mode=TwoWay}">
                <TextBlock Classes="card-title" Text="{Binding I18n[tab3.chk_one_game_one_rom]}" />
              </CheckBox>
              <TextBlock x:Name="LblOneGameOneRomHint"
                         Margin="28,0,0,0"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource HintForegroundBrush}"
                         Text="{Binding Priorities.OneGameOneRomHint}" />

              <!-- The order of the criteria (left) and the setting of the TOSEC names (right), each label in a column of its
                   own. The preferences that criteria compare the releases to are set on the line of their criterion -->
              <Grid x:Name="Grp1G1ROptions"
                    Margin="28,10,0,0"
                    ColumnDefinitions="*,32,*"
                    IsEnabled="{Binding Priorities.Are1G1ROptionsEnabled}">
                <StackPanel x:Name="Grp1G1RGeneralOptions" Grid.Column="0" VerticalAlignment="Top">
                  <TextBlock Classes="section-title" Text="{Binding I18n[tab3.grp_1g1r_general]}" />
                  <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                    <TextBlock Grid.Row="0" Classes="form-label" Text="{Binding I18n[tab3.lbl_tiebreak_order_row]}" />
                    <WrapPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                      <!-- Orders of the 1G1R criteria, one per convention, in a drop-down panel so that the page keeps its height -->
                      <Button x:Name="BtnTiebreakOrder"
                              FontSize="11"
                              MinHeight="24"
                              Padding="10,2"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Content="{Binding I18n[tab3.btn_tiebreak_order]}"
                              ToolTip.Tip="{Binding Priorities.CriteriaOrderTooltip}">
                        <Button.Flyout>
                          <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="wide-panel">
                            <Grid x:Name="GrpTiebreakOrder" RowDefinitions="Auto,4,Auto,6,Auto,4,Auto,2,Auto,2,Auto,2,Auto" ColumnDefinitions="440,3,Auto">
                              <TextBlock Grid.Row="0"
                                         Grid.ColumnSpan="3"
                                         Text="{Binding Priorities.CriteriaOrderTitle}"
                                         FontSize="11"
                                         FontWeight="Bold" />
                              <!-- Each convention has its own order, made of the criteria that can separate two of its
                                   releases; the effective convention is shown, any other can be chosen -->
                              <StackPanel x:Name="PanelTiebreakConvention"
                                          Grid.Row="2"
                                          Grid.ColumnSpan="3"
                                          Orientation="Horizontal"
                                          Spacing="12">
                                <TextBlock Text="{Binding I18n[filters.lbl_convention]}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <RadioButton x:Name="RadioTiebreakTosec"
                                             GroupName="TiebreakConvention"
                                             FontSize="11"
                                             ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_convention]}"
                                             Content="{Binding I18n[tab3.tiebreak_convention_tosec]}"
                                             IsChecked="{Binding Priorities.IsTosecOrderShown, Mode=TwoWay}" />
                                <RadioButton x:Name="RadioTiebreakNoIntro"
                                             GroupName="TiebreakConvention"
                                             FontSize="11"
                                             ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_convention]}"
                                             Content="{Binding I18n[tab3.tiebreak_convention_nointro]}"
                                             IsChecked="{Binding Priorities.IsNoIntroOrderShown, Mode=TwoWay}" />
                                <RadioButton x:Name="RadioTiebreakRedump"
                                             GroupName="TiebreakConvention"
                                             FontSize="11"
                                             ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_convention]}"
                                             Content="{Binding I18n[tab3.tiebreak_convention_redump]}"
                                             IsChecked="{Binding Priorities.IsRedumpOrderShown, Mode=TwoWay}" />
                                <RadioButton x:Name="RadioTiebreakMame"
                                             GroupName="TiebreakConvention"
                                             FontSize="11"
                                             ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_convention]}"
                                             Content="{Binding I18n[tab3.tiebreak_convention_mame]}"
                                             IsChecked="{Binding Priorities.IsMameOrderShown, Mode=TwoWay}" />
                                <RadioButton x:Name="RadioTiebreakSoftwareList"
                                             GroupName="TiebreakConvention"
                                             FontSize="11"
                                             ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_convention]}"
                                             Content="{Binding I18n[tab3.tiebreak_convention_mame_softlist]}"
                                             IsChecked="{Binding Priorities.IsSoftwareListOrderShown, Mode=TwoWay}" />
                              </StackPanel>
                              <ListBox x:Name="ListTiebreakOrder"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       Classes="priority-list"
                                       Height="300"
                                       ItemsSource="{Binding Priorities.ShownCriteriaOrder.Items}"
                                       SelectedItem="{Binding Priorities.ShownCriteriaOrder.SelectedItem, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:TiebreakCriterionItemViewModel">
                                    <!-- Every row has the height of the list some of them carry, and the ranks have a
                                         column of their own, aligned on the right, so that the names line up after "9."
                                         as after "10." -->
                                    <Grid ColumnDefinitions="18,4,*,Auto,Auto"
                                          Height="20"
                                          Background="Transparent"
                                          ToolTip.Tip="{Binding ToolTipText}"
                                          AutomationProperties.Name="{Binding Text}">
                                      <TextBlock x:Name="LblCriterionRank"
                                                 Text="{Binding Rank}"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Classes.no-effect="{Binding HasNoEffect}" />
                                      <TextBlock x:Name="LblCriterionName"
                                                 Grid.Column="2"
                                                 Text="{Binding Label}"
                                                 VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 Classes.no-effect="{Binding HasNoEffect}" />
                                      <!-- What the criterion prefers, set on its line -->
                                      <ComboBox x:Name="ComboTiebreakPreference"
                                                Grid.Column="3"
                                                Width="190"
                                                Height="20"
                                                MinHeight="0"
                                                Margin="6,0,0,0"
                                                Padding="6,0"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasPreference}"
                                                IsEnabled="{Binding Preference.IsEnabled, FallbackValue=False}"
                                                ToolTip.Tip="{Binding Preference.ToolTip}"
                                                ItemsSource="{Binding Preference.Options}"
                                                SelectedItem="{Binding Preference.SelectedOption, Mode=TwoWay}"
                                                DisplayMemberBinding="{Binding Label}" />
                                      <!-- A click opens the table of the results on the games the criterion decided -->
                                      <Button x:Name="BtnDecidedGames"
                                              Grid.Column="4"
                                              Classes="decided-count"
                                              IsVisible="{Binding HasDecisions}"
                                              Command="{Binding ShowDecidedGamesCommand}"
                                              Click="OnDecidedGamesClick"
                                              ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[tab3.tooltip_tiebreak_show_games]}">
                                        <TextBlock x:Name="LblDecidedGames"
                                                   Classes="decided-count"
                                                   Classes.decided-nothing="{Binding DecidedNothing}"
                                                   Text="{Binding DecidedGames}" />
                                      </Button>
                                    </Grid>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                              <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Top" Spacing="2">
                                <Button x:Name="BtnTiebreakMoveUp"
                                        Content="▲"
                                        Width="24"
                                        Height="20"
                                        MinHeight="20"
                                        Padding="0"
                                        FontSize="10"
                                        ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_move_up]}"
                                        AutomationProperties.Name="{Binding I18n[tab3.tooltip_tiebreak_move_up]}"
                                        Command="{Binding Priorities.ShownCriteriaOrder.MoveUpCommand}" />
                                <Button x:Name="BtnTiebreakMoveDown"
                                        Content="▼"
                                        Width="24"
                                        Height="20"
                                        MinHeight="20"
                                        Padding="0"
                                        FontSize="10"
                                        ToolTip.Tip="{Binding I18n[tab3.tooltip_tiebreak_move_down]}"
                                        AutomationProperties.Name="{Binding I18n[tab3.tooltip_tiebreak_move_down]}"
                                        Command="{Binding Priorities.ShownCriteriaOrder.MoveDownCommand}" />
                                <Button x:Name="BtnTiebreakReset"
                                        Content="↺"
                                        Width="24"
                                        Height="20"
                                        MinHeight="20"
                                        Padding="0"
                                        FontSize="11"
                                        ToolTip.Tip="{Binding Priorities.CriteriaOrderResetTooltip}"
                                        AutomationProperties.Name="{Binding Priorities.CriteriaOrderResetTooltip}"
                                        Command="{Binding Priorities.ShownCriteriaOrder.ResetDefaultsCommand}" />
                              </StackPanel>
                              <TextBlock Grid.Row="6"
                                         Grid.ColumnSpan="3"
                                         MaxWidth="470"
                                         HorizontalAlignment="Left"
                                         Text="{Binding I18n[tab3.tiebreak_final_name_note]}"
                                         FontSize="10"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <!-- The criteria of the other conventions are named, never hidden without a word. The
                                   sentences of every order share one cell, only that of the order shown being seen,
                                   so that the panel keeps the height of the longest when another order is shown -->
                              <ItemsControl x:Name="PanelTiebreakLeftOut"
                                            Grid.Row="8"
                                            Grid.ColumnSpan="3"
                                            ItemsSource="{Binding Priorities.CriteriaOrders}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <Grid />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:TiebreakOrderViewModel">
                                    <TextBlock x:Name="LblTiebreakLeftOut"
                                               MaxWidth="470"
                                               HorizontalAlignment="Left"
                                               Text="{Binding LeftOutText}"
                                               Classes.reserved-hidden="{Binding !IsShown}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock x:Name="LblTiebreakNoEffectNote"
                                         Grid.Row="10"
                                         Grid.ColumnSpan="3"
                                         MaxWidth="470"
                                         HorizontalAlignment="Left"
                                         Text="{Binding I18n[tab3.tiebreak_no_effect_note]}"
                                         Classes.reserved-hidden="{Binding !Priorities.ShownCriteriaOrder.HasCriteriaWithoutEffect}"
                                         FontSize="10"
                                         FontStyle="Italic"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <!-- What the numbers are, or how to get them: both share one cell, only one being seen -->
                              <TextBlock x:Name="LblTiebreakDecisionsNote"
                                         Grid.Row="12"
                                         Grid.ColumnSpan="3"
                                         MaxWidth="470"
                                         HorizontalAlignment="Left"
                                         Text="{Binding I18n[tab3.tiebreak_decisions_note]}"
                                         Classes.reserved-hidden="{Binding !Priorities.ShownCriteriaOrder.HasDecisions}"
                                         FontSize="10"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <TextBlock x:Name="LblTiebreakDecisionsHint"
                                         Grid.Row="12"
                                         Grid.ColumnSpan="3"
                                         MaxWidth="470"
                                         HorizontalAlignment="Left"
                                         Text="{Binding I18n[tab3.tiebreak_decisions_hint]}"
                                         Classes.reserved-hidden="{Binding Priorities.ShownCriteriaOrder.HasDecisions}"
                                         FontSize="10"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <TextBlock x:Name="LblRegionModeSummary"
                                 Classes="form-hint"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Text="{Binding Priorities.RegionModeSummary}" />
                    </WrapPanel>
                  </Grid>
                </StackPanel>

                <!-- The 1G1R option that only applies to TOSEC names: always in sight, greyed with a sentence that says
                     why unless the convention is TOSEC or unknown -->
                <StackPanel x:Name="Grp1G1RTosecOptions"
                            Grid.Column="2"
                            VerticalAlignment="Top">
                  <TextBlock Classes="section-title" Text="{Binding I18n[tab3.grp_1g1r_tosec]}" />
                  <TextBlock x:Name="LblTosecOptionsInactive"
                             Classes="form-hint"
                             Margin="0,0,0,6"
                             IsVisible="{Binding !Priorities.AreTosecOptionsApplicable}"
                             Text="{Binding I18n[tab3.hint_tosec_options_inactive]}" />
                  <Grid x:Name="GridTosecOptions"
                        ColumnDefinitions="Auto,12,*"
                        RowDefinitions="Auto"
                        IsEnabled="{Binding Priorities.AreTosecOptionsApplicable}">
                    <!-- A box carries its own label: it takes the width of the form, from the column of the labels -->
                    <CheckBox x:Name="ChkIgnoreModifications"
                              Grid.Row="0" Grid.ColumnSpan="3"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab3.tooltip_ignore_modifications]}"
                              IsChecked="{Binding TosecFilters.IgnoreModificationsInPriority, Mode=TwoWay}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab3.chk_ignore_modifications]}" />
                    </CheckBox>
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- =============================================================== -->
      <!-- STEP 3: Output (destination, mode, conflicts, directory tree)   -->
      <!-- =============================================================== -->
      <Border x:Name="PageOutput" Classes="step-page" IsVisible="{Binding Navigation.IsOutputShown}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <!-- The destination, then how the files are written and where the multi-disk games go, side by side, then the
               directory tree, whose preview gets the whole width. The labels of the full-width frames share a column -->
          <StackPanel Margin="4,2" Spacing="12" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">

            <!-- Destination -->
            <Border x:Name="CardDestination" Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Classes="card-title" Text="{Binding I18n[tab1.card_destination]}" />
                <Grid RowDefinitions="Auto,6,Auto,0,Auto,Auto">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OutputLabel" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Classes="form-label" Text="{Binding I18n[tab1.lbl_dest]}" />
                  <TextBox x:Name="EditDest"
                           Grid.Row="0"
                           Grid.Column="2"
                           FontSize="11"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_dest]}"
                           Watermark="{Binding I18n[tab1.edit_dest_placeholder]}"
                           Text="{Binding Directories.DestinationDir, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <Button x:Name="BtnClearDest"
                              Classes="field-clear"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_clear_dest]}"
                              AutomationProperties.Name="{Binding I18n[tab1.tooltip_clear_dest]}"
                              IsVisible="{Binding Directories.DestinationDir, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Command="{Binding Directories.ClearDestinationCommand}" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                  <Button x:Name="BtnBrowseDest"
                          Grid.Row="0"
                          Grid.Column="4"
                          Content="{Binding I18n[tab1.btn_browse]}"
                          ToolTip.Tip="{Binding I18n[tab1.tooltip_browse_dest]}"
                          FontSize="11"
                          Command="{Binding Directories.BrowseDestinationCommand}" />
                  <CheckBox x:Name="ChkAppendToDestination"
                            Grid.Row="2"
                            Grid.Column="2"
                            Grid.ColumnSpan="3"
                            FontSize="11"
                            Content="{Binding I18n[tab1.chk_append_to_destination]}"
                            ToolTip.Tip="{Binding I18n[tab1.tooltip_append_to_destination]}"
                            IsChecked="{Binding Directories.AppendToDestination, Mode=TwoWay}" />
                  <!-- What happens otherwise: nothing is deleted, the content is set aside after a confirmation -->
                  <TextBlock x:Name="LblAppendHint"
                             Grid.Row="4"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Margin="28,0,0,0"
                             Classes="form-hint"
                             Text="{Binding I18n[tab1.hint_append]}" />

                  <!-- Quarantine of the purges of a destination of RomSieve: what it holds, and how to empty it for good,
                       as a purge never deletes anything. Shown even when empty, so that it is known before it is needed -->
                  <WrapPanel x:Name="PanelQuarantine"
                             Grid.Row="5"
                             Margin="0,8,0,0"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Orientation="Horizontal"
                             IsVisible="{Binding Quarantine.HasDestination}">
                    <TextBlock x:Name="LblQuarantine"
                               Classes="form-label"
                               Margin="0,0,12,0"
                               Text="{Binding Quarantine.SummaryText}" />
                    <Button x:Name="BtnEmptyQuarantine"
                            MinHeight="24"
                            Padding="10,2"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Content="{Binding I18n[quarantine.btn_empty]}"
                            ToolTip.Tip="{Binding Quarantine.EmptyTooltip}"
                            ToolTip.ShowOnDisabled="True"
                            Command="{Binding Quarantine.EmptyCommand}" />
                  </WrapPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,16,*">
              <!-- How the files are written: mode, conflicts and verification of the copies -->
              <Border x:Name="CardWriting" Grid.Column="0" Classes="settings-card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="card-title" Text="{Binding I18n[tab1.card_writing]}" />
                  <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,6,Auto,6,Auto,4,Auto">
                    <!-- Each label is as tall as the first line of its controls, so that it faces it even when they wrap -->
                    <Panel Grid.Row="0"
                           VerticalAlignment="Top"
                           Height="{Binding #ComboTransferMode.Bounds.Height}">
                      <TextBlock x:Name="LblMode" Classes="form-label" Text="{Binding I18n[tab1.lbl_mode]}" />
                    </Panel>
                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Top">
                      <!-- A list whose entries say what each mode does -->
                      <WrapPanel Orientation="Horizontal">
                        <ComboBox x:Name="ComboTransferMode"
                                  MinWidth="195"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  ToolTip.Tip="{Binding I18n[tab1.tooltip_mode]}"
                                  ItemsSource="{Binding Directories.TransferModeOptions}"
                                  SelectedValueBinding="{Binding Value}"
                                  SelectedValue="{Binding Directories.SelectedTransferMode, Mode=TwoWay}">
                          <!-- Open list: the name of each mode and what it does; closed: the name only -->
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferModeOptionViewModel">
                              <StackPanel Spacing="1" ToolTip.Tip="{Binding Details}">
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                          <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="vm:TransferModeOptionViewModel">
                              <TextBlock Text="{Binding Label}" FontSize="11" />
                            </DataTemplate>
                          </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                      </WrapPanel>
                      <!-- What the selected mode does to the source and where it can write -->
                      <TextBlock x:Name="LblTransferModeHint"
                                 Classes="form-hint"
                                 Text="{Binding Directories.TransferModeHint}" />
                    </StackPanel>

                    <Panel Grid.Row="2"
                           VerticalAlignment="Top"
                           Height="{Binding #ComboConflicts.Bounds.Height}">
                      <TextBlock x:Name="LblConflicts" Classes="form-label" Text="{Binding I18n[tab1.lbl_conflicts]}" />
                    </Panel>
                    <WrapPanel x:Name="PanelConflicts"
                               Grid.Row="2"
                               Grid.Column="2"
                               Orientation="Horizontal"
                               VerticalAlignment="Top">
                      <ComboBox x:Name="ComboConflicts"
                                MinWidth="195"
                                VerticalAlignment="Center"
                                FontSize="11"
                                ToolTip.Tip="{Binding I18n[tab1.tooltip_conflicts]}"
                                ItemsSource="{Binding Directories.CollisionModeOptions}"
                                SelectedValueBinding="{Binding Value}"
                                DisplayMemberBinding="{Binding Label}"
                                SelectedValue="{Binding Directories.SelectedCollisionMode, Mode=TwoWay}" />
                    </WrapPanel>

                    <CheckBox x:Name="ChkVerifyCopies"
                              Grid.Row="4"
                              Grid.Column="2"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_verify_copies]}"
                              IsChecked="{Binding Directories.VerifyCopies, Mode=TwoWay}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab1.chk_verify_copies]}" />
                    </CheckBox>
                    <CheckBox x:Name="ChkIsolateUnmatched"
                              Grid.Row="6"
                              Grid.Column="2"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_isolate_unmatched]}"
                              IsChecked="{Binding Directories.IsolateUnmatched, Mode=TwoWay}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab1.chk_isolate_unmatched]}" />
                    </CheckBox>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Multi-disk games: a subfolder each, and a playlist whose placement is indented under it -->
              <Border x:Name="CardMultidisk" Grid.Column="2" Classes="settings-card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="card-title" Text="{Binding I18n[tab1.card_multidisk]}" />
                  <StackPanel Spacing="4">
                    <CheckBox x:Name="ChkSubfolderMultidisk"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_subfolder_multidisk]}"
                              IsChecked="{Binding Directories.SubfolderMultidisk, Mode=TwoWay}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab1.chk_subfolder_multidisk]}" />
                    </CheckBox>
                    <CheckBox x:Name="ChkGenerateM3u"
                              FontSize="11"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_generate_m3u]}"
                              IsChecked="{Binding Directories.GenerateM3u, Mode=TwoWay}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding I18n[tab1.chk_generate_m3u]}" />
                    </CheckBox>
                    <!-- .m3u placement indented under the .m3u option, which enables it -->
                    <!-- A grid rather than a row: the list keeps to the room left in the narrow frame -->
                    <Grid x:Name="ContainerM3uPlacement"
                          ColumnDefinitions="Auto,8,*"
                          Margin="28,0,0,0"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding Directories.IsM3uPlacementEnabled}">
                      <TextBlock Classes="form-label" Text="{Binding I18n[tab1.lbl_m3u_placement]}" />
                      <ComboBox x:Name="ComboM3uPlacement"
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                FontSize="11"
                                ToolTip.Tip="{Binding I18n[tab1.tooltip_m3u_placement]}"
                                ItemsSource="{Binding Directories.M3uPlacementOptions}"
                                SelectedValueBinding="{Binding Value}"
                                DisplayMemberBinding="{Binding Label}"
                                SelectedValue="{Binding Directories.SelectedM3uPlacement, Mode=TwoWay}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Directory tree: the organization of the destination, the pattern, greyed but kept when everything goes at
                 the root, its menus on its line, and the live preview of the paths in a box of its own -->
            <Border x:Name="CardPattern" Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Classes="card-title" Text="{Binding I18n[tab1.grp_pattern]}" />
                <Grid RowDefinitions="Auto,0,Auto,8,Auto,6,Auto,0,Auto,8,Auto">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OutputLabel" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Organization of the destination: folders from the pattern, or everything at the root. A choice in
                       sight, above the pattern it greys out; the option stays apart from the pattern, which it keeps -->
                  <TextBlock Grid.Row="0" Classes="form-label" Text="{Binding I18n[tab1.lbl_layout]}" />
                  <WrapPanel x:Name="PanelLayout"
                             Grid.Row="0"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Orientation="Horizontal">
                    <RadioButton x:Name="RadioLayoutPattern"
                                 GroupName="DestinationLayout"
                                 Margin="0,0,20,0"
                                 FontSize="11"
                                 ToolTip.Tip="{Binding I18n[tab1.tooltip_layout_pattern]}"
                                 Content="{Binding I18n[tab1.layout_pattern]}"
                                 IsChecked="{Binding Directories.IsPatternLayout, Mode=TwoWay}" />
                    <RadioButton x:Name="RadioLayoutRoot"
                                 GroupName="DestinationLayout"
                                 FontSize="11"
                                 ToolTip.Tip="{Binding I18n[tab1.tooltip_flat_destination]}"
                                 Content="{Binding I18n[tab1.chk_flat_destination]}"
                                 IsChecked="{Binding Directories.IsRootLayout, Mode=TwoWay}" />
                  </WrapPanel>
                  <TextBlock x:Name="LblFlatDestinationNote"
                             Grid.Row="2"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Classes="form-hint"
                             Text="{Binding I18n[tab1.flat_destination_note]}"
                             IsVisible="{Binding Directories.FlatDestination}" />

                  <TextBlock Grid.Row="4" Classes="form-label" Text="{Binding I18n[tab1.lbl_pattern]}" />
                  <TextBox x:Name="EditPattern"
                           Grid.Row="4"
                           Grid.Column="2"
                           FontSize="11"
                           IsEnabled="{Binding Directories.IsPatternEditingEnabled}"
                           ToolTip.Tip="{Binding I18n[tab1.tooltip_pattern]}"
                           Text="{Binding Directories.Pattern, Mode=TwoWay}" />
                  <!-- Variables inserted at the caret, and preset patterns (a preset goes back to the folders) -->
                  <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <DropDownButton x:Name="BtnInsertVariable"
                                    Content="{Binding I18n[tab1.btn_insert_variable]}"
                                    ToolTip.Tip="{Binding I18n[tab1.tooltip_insert_variable]}"
                                    IsEnabled="{Binding Directories.IsPatternEditingEnabled}"
                                    FontSize="11"
                                    MinHeight="24"
                                    Padding="8,0">
                      <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem x:Name="MenuVariableTitle" Header="{Binding Directories.PatternVariables[0].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[0].Tooltip}" Command="{Binding Directories.PatternVariables[0].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableLetter" Header="{Binding Directories.PatternVariables[1].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[1].Tooltip}" Command="{Binding Directories.PatternVariables[1].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableCountry" Header="{Binding Directories.PatternVariables[2].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[2].Tooltip}" Command="{Binding Directories.PatternVariables[2].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableLanguage" Header="{Binding Directories.PatternVariables[3].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[3].Tooltip}" Command="{Binding Directories.PatternVariables[3].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableVersion" Header="{Binding Directories.PatternVariables[4].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[4].Tooltip}" Command="{Binding Directories.PatternVariables[4].InsertCommand}" />
                          <!-- Variables of TOSEC names, then of the MAME categories: greyed out (never hidden) when the
                               effective convention gives them no value, their tooltip saying when they apply -->
                          <Separator />
                          <MenuItem x:Name="MenuVariablePublisher" IsEnabled="{Binding Directories.PatternVariables[5].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[5].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[5].Tooltip}" Command="{Binding Directories.PatternVariables[5].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableYear" IsEnabled="{Binding Directories.PatternVariables[6].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[6].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[6].Tooltip}" Command="{Binding Directories.PatternVariables[6].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableSystem" IsEnabled="{Binding Directories.PatternVariables[7].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[7].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[7].Tooltip}" Command="{Binding Directories.PatternVariables[7].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableChipset" IsEnabled="{Binding Directories.PatternVariables[8].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[8].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[8].Tooltip}" Command="{Binding Directories.PatternVariables[8].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableVideo" IsEnabled="{Binding Directories.PatternVariables[9].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[9].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[9].Tooltip}" Command="{Binding Directories.PatternVariables[9].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableDumpStatus" IsEnabled="{Binding Directories.PatternVariables[10].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[10].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[10].Tooltip}" Command="{Binding Directories.PatternVariables[10].InsertCommand}" />
                          <Separator />
                          <MenuItem x:Name="MenuVariableGenre" IsEnabled="{Binding Directories.PatternVariables[11].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[11].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[11].Tooltip}" Command="{Binding Directories.PatternVariables[11].InsertCommand}" />
                          <MenuItem x:Name="MenuVariableCategory" IsEnabled="{Binding Directories.PatternVariables[12].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[12].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[12].Tooltip}" Command="{Binding Directories.PatternVariables[12].InsertCommand}" />
                          <!-- The DAT of each file: greyed out without a DAT -->
                          <Separator />
                          <MenuItem x:Name="MenuVariableDat" IsEnabled="{Binding Directories.PatternVariables[13].IsApplicable}" ToolTip.ShowOnDisabled="True" Header="{Binding Directories.PatternVariables[13].Label}" ToolTip.Tip="{Binding Directories.PatternVariables[13].Tooltip}" Command="{Binding Directories.PatternVariables[13].InsertCommand}" />
                        </MenuFlyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="BtnPatternPresets"
                                    Content="{Binding I18n[tab1.btn_presets]}"
                                    ToolTip.Tip="{Binding I18n[tab1.tooltip_presets]}"
                                    FontSize="11"
                                    MinHeight="24"
                                    Padding="8,0">
                      <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem x:Name="MenuPresetTosec"
                                    Header="{Binding I18n[tab1.preset_tosec]}"
                                    ToolTip.Tip="{Binding I18n[tab1.tooltip_preset_tosec]}"
                                    Command="{Binding Directories.ResetPatternCommand}" />
                          <MenuItem x:Name="MenuPresetRegion"
                                    Header="{Binding I18n[tab1.preset_region]}"
                                    ToolTip.Tip="{Binding I18n[tab1.tooltip_preset_region]}"
                                    Command="{Binding Directories.PresetNoIntroRegionCommand}" />
                          <MenuItem x:Name="MenuPresetLetter"
                                    Header="{Binding I18n[tab1.preset_letter]}"
                                    ToolTip.Tip="{Binding I18n[tab1.tooltip_preset_letter]}"
                                    Command="{Binding Directories.PresetNoIntroLetterCommand}" />
                          <MenuItem x:Name="MenuPresetAmigaChipset"
                                    Header="{Binding I18n[tab1.preset_amiga_chipset]}"
                                    ToolTip.Tip="{Binding I18n[tab1.tooltip_preset_amiga_chipset]}"
                                    Command="{Binding Directories.PresetAmigaChipsetCommand}" />
                        </MenuFlyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                  </StackPanel>

                  <!-- Also at the root: the subfolder of a multi-disk game is named after its title -->
                  <CheckBox x:Name="ChkRestoreArticles"
                            Grid.Row="6"
                            Grid.Column="2"
                            Grid.ColumnSpan="3"
                            FontSize="11"
                            ToolTip.Tip="{Binding I18n[tab1.tooltip_restore_articles]}"
                            Content="{Binding I18n[tab1.chk_restore_articles]}"
                            IsChecked="{Binding Directories.RestoreArticles, Mode=TwoWay}" />
                  <!-- A lot of DATs: a folder per DAT above the pattern, under the folders of its path when mirrored;
                       greyed out for a single DAT, their tooltip saying when they apply -->
                  <WrapPanel x:Name="PanelDatFolders"
                             Grid.Row="8"
                             Grid.Column="2"
                             Grid.ColumnSpan="3"
                             Orientation="Horizontal">
                    <CheckBox x:Name="ChkFolderPerDat"
                              Margin="0,0,20,0"
                              FontSize="11"
                              Content="{Binding I18n[tab1.chk_folder_per_dat]}"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_folder_per_dat]}"
                              ToolTip.ShowOnDisabled="True"
                              IsEnabled="{Binding Directories.HoldsSeveralDats}"
                              IsChecked="{Binding Directories.FolderPerDat, Mode=TwoWay}" />
                    <CheckBox x:Name="ChkDatFolderMirror"
                              FontSize="11"
                              Content="{Binding I18n[tab1.chk_dat_folder_mirror]}"
                              ToolTip.Tip="{Binding I18n[tab1.tooltip_dat_folder_mirror]}"
                              ToolTip.ShowOnDisabled="True"
                              IsEnabled="{Binding Directories.IsDatFolderMirrorEnabled}"
                              IsChecked="{Binding Directories.DatFolderMirror, Mode=TwoWay}" />
                  </WrapPanel>
                  <!-- Live preview: paths computed by the code of the sort for a few files -->
                  <Border Grid.Row="10"
                          Grid.ColumnSpan="5"
                          Padding="10,6"
                          CornerRadius="4"
                          BorderThickness="1"
                          Background="{DynamicResource PanelBackgroundBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}">
                    <StackPanel x:Name="PanelPatternPreview"
                                Spacing="2"
                                ToolTip.Tip="{Binding I18n[tab1.tooltip_preview]}">
                      <TextBlock x:Name="LblPreviewCaption"
                                 Text="{Binding Directories.Preview.CaptionText}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource HintForegroundBrush}" />
                      <ItemsControl x:Name="ListPatternPreview" ItemsSource="{Binding Directories.Preview.Examples}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PatternPreviewExample">
                            <!-- The end of the path (folders and file) matters most: a long path loses its beginning -->
                            <TextBlock Text="{Binding TargetPath}"
                                       ToolTip.Tip="{Binding Tooltip}"
                                       FontSize="11"
                                       TextTrimming="LeadingCharacterEllipsis" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock x:Name="LblPreviewWarning"
                                 Text="{Binding Directories.Preview.WarningText}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource PatternWarningForegroundBrush}"
                                 IsVisible="{Binding Directories.Preview.HasWarning}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- =============================================================== -->
      <!-- STEP 4: Results (statistics, preview table and log), full height -->
      <!-- =============================================================== -->
      <DockPanel x:Name="PageResults" IsVisible="{Binding Navigation.IsResultsShown}">
        <DockPanel DockPanel.Dock="Top">
          <Button x:Name="BtnBackToSettings"
                  DockPanel.Dock="Left"
                  Classes="secondary-action"
                  Margin="0,0,6,4"
                  VerticalAlignment="Stretch"
                  Content="{Binding I18n[nav.btn_back_to_settings]}"
                  ToolTip.Tip="{Binding I18n[nav.tooltip_back_to_settings]}"
                  Command="{Binding Navigation.ReturnToSettingsCommand}" />

          <!-- Interactive statistics banner (StatsBanner) -->
          <Border DockPanel.Dock="Top"
                  Background="{DynamicResource StatsBannerBackgroundBrush}"
                  BorderBrush="{DynamicResource StatsBannerBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="8,2"
                  Margin="0,0,0,4">
            <!-- The totals go under the chips when both do not fit side by side; arranged again when a chip or a total
                 changes its width in the layout pass that hides the progress row -->
            <controls:TwoSidedWrapPanel x:Name="PanelStatsBanner" Spacing="12" RowSpacing="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleButton x:Name="ChipTotal"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.TotalChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.TotalChip.Tooltip}"
                              IsChecked="{Binding StatsBanner.TotalChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.TotalChip.ClickCommand}" />
                <ToggleButton x:Name="ChipValid"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.ValidChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.ValidChip.Tooltip}"
                              IsChecked="{Binding StatsBanner.ValidChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.ValidChip.ClickCommand}" />
                <ToggleButton x:Name="ChipExcluded"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.ExcludedChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.ExcludedChip.Tooltip}"
                              IsChecked="{Binding StatsBanner.ExcludedChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.ExcludedChip.ClickCommand}" />
                <ToggleButton x:Name="ChipUnmatched"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.UnmatchedChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.UnmatchedChip.Tooltip}"
                              IsChecked="{Binding StatsBanner.UnmatchedChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.UnmatchedChip.ClickCommand}" />
                <ToggleButton x:Name="ChipDuplicates"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.DuplicateChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.DuplicateChip.Tooltip}"
                              IsChecked="{Binding StatsBanner.DuplicateChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.DuplicateChip.ClickCommand}" />
                <ToggleButton x:Name="ChipChanged"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.ChangedChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.ChangedChip.Tooltip}"
                              IsVisible="{Binding StatsBanner.IsChangedChipVisible}"
                              IsChecked="{Binding StatsBanner.ChangedChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.ChangedChip.ClickCommand}" />
                <ToggleButton x:Name="ChipSelection"
                              Classes="stat-chip"
                              Content="{Binding StatsBanner.SelectionChip.Text}"
                              ToolTip.Tip="{Binding StatsBanner.SelectionChip.Tooltip}"
                              IsVisible="{Binding StatsBanner.IsSelectionChipVisible}"
                              IsChecked="{Binding StatsBanner.SelectionChip.IsChecked, Mode=OneWay}"
                              Command="{Binding StatsBanner.SelectionChip.ClickCommand}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="LblDatStats"
                           Text="{Binding StatsBanner.DatStatsText}"
                           IsVisible="{Binding StatsBanner.IsDatStatsVisible}"
                           ToolTip.Tip="{Binding StatsBanner.DatStatsTooltip}"
                           Foreground="{DynamicResource DatStatsForegroundBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="LblVolume"
                           Text="{Binding StatsBanner.VolumeText}"
                           ToolTip.Tip="{Binding StatsBanner.VolumeTooltip}"
                           Foreground="{DynamicResource VolumeForegroundBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="LblFat32Warning"
                           Text="{Binding StatsBanner.Fat32WarningText}"
                           ToolTip.Tip="{Binding StatsBanner.Fat32WarningTooltip}"
                           IsVisible="{Binding StatsBanner.IsFat32WarningVisible}"
                           Foreground="{DynamicResource SizeWarningForegroundBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <!-- Kept files that the destination already holds: counted as duplicates, not written again -->
                <TextBlock x:Name="LblAlreadyInDestination"
                           Text="{Binding StatsBanner.AlreadyInDestinationText}"
                           ToolTip.Tip="{Binding StatsBanner.AlreadyInDestinationTooltip}"
                           IsVisible="{Binding StatsBanner.IsAlreadyInDestinationVisible}"
                           Foreground="{DynamicResource SizeWarningForegroundBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </controls:TwoSidedWrapPanel>
          </Border>
        </DockPanel>

        <!-- Simulation preview (10 columns) and operations log -->
        <TabControl x:Name="BottomTabs"
                    SelectedIndex="{Binding ActiveBottomTabIndex, Mode=TwoWay}">

          <!-- Tab 0: Simulation preview -->
          <TabItem Header="{Binding I18n[panel4.tab_preview]}"
                   ToolTip.Tip="{Binding I18n[panel4.tooltip_tab_preview]}">
            <DockPanel Margin="0,2,0,0">

              <!-- Search bar by game title with autocomplete -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,4,*,4,Auto,8,Auto,6,Auto,8,Auto,6,Auto,4,Auto" Margin="2,0,2,3" VerticalAlignment="Center">
                <TextBlock x:Name="LblSearchPreview"
                           Grid.Column="0"
                           Text="{Binding I18n[panel4.lbl_search_title]}"
                           FontWeight="Bold"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <AutoCompleteBox x:Name="EditSearchPreview"
                                 Grid.Column="2"
                                 FontSize="11"
                                 MinHeight="24"
                                 Height="24"
                                 Padding="6,2"
                                 VerticalAlignment="Center"
                                 FilterMode="Contains"
                                 Watermark="{Binding I18n[panel4.search_title_placeholder]}"
                                 ToolTip.Tip="{Binding I18n[panel4.tooltip_search_title]}"
                                 AsyncPopulator="{Binding PopulatePreviewTitleSuggestions}"
                                 Text="{Binding PreviewSearchText, Mode=TwoWay}" />

                <Button x:Name="BtnClearSearchPreview"
                        Grid.Column="4"
                        Width="24"
                        Height="24"
                        MinHeight="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="✕"
                        FontWeight="Bold"
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                        Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        ToolTip.Tip="{Binding I18n[panel4.tooltip_clear_search_title]}"
                        AutomationProperties.Name="{Binding I18n[panel4.tooltip_clear_search_title]}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding ClearPreviewSearchCommand}" />

                <!-- Checks or unchecks every game of the rows shown; partly checked when only some are -->
                <CheckBox x:Name="ChkCheckAllShown"
                          Grid.Column="6"
                          FontSize="11"
                          MinHeight="24"
                          VerticalAlignment="Center"
                          Content="{Binding I18n[panel4.chk_check_all]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_check_all]}"
                          IsEnabled="{Binding PartialSort.CanCheckShownRows}"
                          IsThreeState="False"
                          IsChecked="{Binding PartialSort.AreShownRowsChecked, Mode=TwoWay}" />

                <!-- Number of games checked for the sort (all of them after a simulation), and of those the filters hide.
                     It grows with the games hidden and takes its room from the search box: the controls on its right
                     (list of the DATs, buttons) stay in place when a DAT is chosen -->
                <TextBlock x:Name="LblCheckedCount"
                           Grid.Column="8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           IsVisible="{Binding PartialSort.IsSelectionAvailable}"
                           ToolTip.Tip="{Binding PartialSort.CheckedCountTooltip}"
                           Text="{Binding PartialSort.CheckedCountText}" />

                <!-- The files of one DAT of a lot; greyed out for a run with a single DAT, which has none to choose.
                     A fixed width, the name trimmed: sized to the DAT chosen, the list moved the buttons on its right -->
                <ComboBox x:Name="ComboDatFilter"
                          Grid.Column="10"
                          Width="220"
                          FontSize="11"
                          MinHeight="24"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_dat_filter]}"
                          ToolTip.ShowOnDisabled="True"
                          IsEnabled="{Binding PreviewTable.HasDatFilter}"
                          ItemsSource="{Binding PreviewTable.DatFilterOptions}"
                          SelectedItem="{Binding PreviewTable.SelectedDatFilter, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DatFilterOption">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- View grouped by game: a header row per game of several files, the 1G1R winner first -->
                <ToggleButton x:Name="BtnGroupByGame"
                              Grid.Column="12"
                              Content="{Binding I18n[panel4.btn_group_by_game]}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_group_by_game]}"
                              IsChecked="{Binding PreviewTable.IsGroupedByGame, Mode=TwoWay}"
                              FontSize="11"
                              MinHeight="24"
                              Height="24"
                              Padding="8,0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center" />

                <!-- Shown columns: all but the source name and the status can be hidden -->
                <DropDownButton x:Name="BtnColumns"
                                Grid.Column="14"
                                Content="{Binding I18n[panel4.btn_columns]}"
                                ToolTip.Tip="{Binding I18n[panel4.tooltip_columns]}"
                                FontSize="11"
                                MinHeight="24"
                                Height="24"
                                Padding="8,0"
                                VerticalAlignment="Center">
                  <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem x:Name="MenuColumnCrc" Header="{Binding PreviewTable.Columns[1].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[1].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnTitle" Header="{Binding PreviewTable.Columns[2].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[2].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnDisk" Header="{Binding PreviewTable.Columns[3].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[3].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnRelated" Header="{Binding PreviewTable.Columns[10].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[10].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnPublisher" Header="{Binding PreviewTable.Columns[4].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[4].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnDate" Header="{Binding PreviewTable.Columns[5].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[5].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnLanguages" Header="{Binding PreviewTable.Columns[6].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[6].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnCountry" Header="{Binding PreviewTable.Columns[7].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[7].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnTarget" Header="{Binding PreviewTable.Columns[8].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[8].IsVisible, Mode=TwoWay}" />
                      <MenuItem x:Name="MenuColumnDat" Header="{Binding PreviewTable.Columns[11].Header}" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding PreviewTable.Columns[11].IsVisible, Mode=TwoWay}" />
                      <Separator />
                      <MenuItem x:Name="MenuColumnsReset"
                                Header="{Binding I18n[panel4.menu_columns_reset]}"
                                Command="{Binding PreviewTable.ResetColumnsCommand}" />
                    </MenuFlyout>
                  </DropDownButton.Flyout>
                </DropDownButton>

              </Grid>

              <!-- Only the games a 1G1R criterion decided are shown (a count of the order of the criteria was clicked) -->
              <Border x:Name="PanelCriterionFilter"
                      DockPanel.Dock="Top"
                      Margin="2,0,2,3"
                      Padding="8,2,2,2"
                      CornerRadius="4"
                      BorderThickness="1"
                      Background="{DynamicResource StatsBannerBackgroundBrush}"
                      BorderBrush="{DynamicResource StatsBannerBorderBrush}"
                      IsVisible="{Binding PreviewTable.HasCriterionFilter}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LblCriterionFilter"
                             FontSize="11"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Text="{Binding PreviewTable.CriterionFilterText}" />
                  <Button x:Name="BtnClearCriterionFilter"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          MinHeight="22"
                          Height="22"
                          Padding="8,0"
                          FontSize="11"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Content="{Binding I18n[panel4.btn_clear_criterion_filter]}"
                          ToolTip.Tip="{Binding I18n[panel4.tooltip_clear_criterion_filter]}"
                          Command="{Binding PreviewTable.ClearCriterionFilterCommand}" />
                </Grid>
              </Border>

              <!-- Detail of the selected row: full names and paths, status and reason, CRC32 -->
              <Expander x:Name="PreviewDetailPanel"
                        DockPanel.Dock="Bottom"
                        Margin="0,3,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{Binding PreviewTable.IsDetailPanelExpanded, Mode=TwoWay}"
                        ToolTip.Tip="{Binding I18n[panel4.tooltip_detail_panel]}">
                <!-- Compact header and content: the Fluent header is 48 px high -->
                <Expander.Resources>
                  <x:Double x:Key="ExpanderMinHeight">24</x:Double>
                  <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                  <Thickness x:Key="ExpanderHeaderPadding">8,0,4,0</Thickness>
                  <Thickness x:Key="ExpanderContentPadding">8,4</Thickness>
                  <Thickness x:Key="ExpanderChevronMargin">8,0,0,0</Thickness>
                </Expander.Resources>
                <Expander.Header>
                  <TextBlock Text="{Binding I18n[panel4.detail_title]}" FontSize="11" FontWeight="SemiBold" />
                </Expander.Header>
                <Panel>
                  <TextBlock x:Name="LblDetailEmpty"
                             Text="{Binding I18n[panel4.detail_none]}"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             IsVisible="{Binding PreviewTable.SelectedPreviewItem, Converter={x:Static ObjectConverters.IsNull}}" />
                  <Grid x:Name="GridDetail"
                        IsVisible="{Binding PreviewTable.SelectedPreviewItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ColumnDefinitions="Auto,8,*,16,Auto,8,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!-- The same gap under every line, carried by its texts rather than by spacer rows: a hidden line (no
                         CHD, no MAME set...) then leaves no gap of its own, and the lines stay evenly spaced -->
                    <Grid.Styles>
                      <Style Selector="Grid#GridDetail > TextBlock, Grid#GridDetail > SelectableTextBlock, Grid#GridDetail > DockPanel, Grid#GridDetail > ScrollViewer">
                        <Setter Property="Margin" Value="0,0,0,3" />
                      </Style>
                    </Grid.Styles>
                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" FontWeight="SemiBold" Text="{Binding I18n[panel4.detail_source_name]}" />
                    <SelectableTextBlock x:Name="LblDetailSourceName" Grid.Row="0" Grid.Column="2" FontSize="11" TextWrapping="Wrap" Text="{Binding PreviewTable.SelectedPreviewItem.SourceName}" />
                    <!-- Checksum of the row (SHA-1 of a CHD, otherwise CRC32), hidden when it has none, like a MAME set -->
                    <TextBlock x:Name="LblDetailChecksumLabel" Grid.Row="0" Grid.Column="4" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding PreviewTable.SelectedPreviewItem.DetailChecksumLabel}"
                               IsVisible="{Binding PreviewTable.SelectedPreviewItem.DetailChecksumText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <SelectableTextBlock x:Name="LblDetailCrc" Grid.Row="0" Grid.Column="6" FontSize="11" FontFamily="Monospace"
                                         Text="{Binding PreviewTable.SelectedPreviewItem.DetailChecksumText}"
                                         IsVisible="{Binding PreviewTable.SelectedPreviewItem.DetailChecksumText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" FontWeight="SemiBold" Text="{Binding I18n[panel4.detail_source_path]}" />
                    <SelectableTextBlock x:Name="LblDetailSourcePath" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap" Text="{Binding PreviewTable.SelectedPreviewItem.SourcePathDisplay}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" FontWeight="SemiBold" Text="{Binding I18n[panel4.detail_target_path]}" />
                    <SelectableTextBlock x:Name="LblDetailTarget" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap" Text="{Binding PreviewTable.SelectedPreviewItem.FullTargetPath}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Top" Text="{Binding I18n[panel4.detail_status]}" />
                    <DockPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="5">
                      <Border x:Name="BadgeDetailStatus"
                              DockPanel.Dock="Left"
                              CornerRadius="3"
                              Padding="6,0"
                              Margin="0,0,8,0"
                              VerticalAlignment="Top">
                        <Border.Background>
                          <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Status*BadgeBackgroundBrush">
                            <Binding Path="PreviewTable.SelectedPreviewItem.Status" />
                            <Binding Path="$self.ActualThemeVariant" />
                          </MultiBinding>
                        </Border.Background>
                        <TextBlock Text="{Binding PreviewTable.SelectedPreviewItem.StatusLabel}" FontSize="11" FontWeight="SemiBold">
                          <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Status*BadgeForegroundBrush">
                              <Binding Path="PreviewTable.SelectedPreviewItem.Status" />
                              <Binding Path="$self.ActualThemeVariant" />
                            </MultiBinding>
                          </TextBlock.Foreground>
                        </TextBlock>
                      </Border>
                      <SelectableTextBlock x:Name="LblDetailReason" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding PreviewTable.SelectedPreviewItem.StatusReasonText}" />
                    </DockPanel>
                    <!-- The DAT of a lot the file is sorted with, and the other DATs that know it -->
                    <TextBlock Grid.Row="9" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding I18n[panel4.detail_dat]}"
                               IsVisible="{Binding PreviewTable.SelectedPreviewItem.DetailDatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                    <SelectableTextBlock x:Name="LblDetailDat" Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap"
                                         Text="{Binding PreviewTable.SelectedPreviewItem.DetailDatText}"
                                         IsVisible="{Binding PreviewTable.SelectedPreviewItem.DetailDatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                    <!-- What the MAME set holds compared with its machine -->
                    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding I18n[panel4.detail_mame_set]}"
                               IsVisible="{Binding PreviewTable.SelectedPreviewItem.MameSetText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <SelectableTextBlock x:Name="LblDetailMameSet" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap"
                                         Text="{Binding PreviewTable.SelectedPreviewItem.MameSetText}"
                                         IsVisible="{Binding PreviewTable.SelectedPreviewItem.MameSetText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Machines that take ROMs from the MAME set (clones, games of a BIOS, users of a device) -->
                    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding I18n[panel4.detail_mame_used_by]}"
                               ToolTip.Tip="{Binding I18n[panel4.tooltip_detail_mame_used_by]}"
                               IsVisible="{Binding PreviewTable.SelectedMameUsersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <SelectableTextBlock x:Name="LblDetailMameUsedBy" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap"
                                         Text="{Binding PreviewTable.SelectedMameUsersText}"
                                         IsVisible="{Binding PreviewTable.SelectedMameUsersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Version, media and tracks of a CHD -->
                    <TextBlock Grid.Row="6" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding I18n[panel4.detail_chd]}"
                               IsVisible="{Binding PreviewTable.SelectedPreviewItem.DetailChdText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <SelectableTextBlock x:Name="LblDetailChd" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap"
                                         Text="{Binding PreviewTable.SelectedPreviewItem.DetailChdText}"
                                         IsVisible="{Binding PreviewTable.SelectedPreviewItem.DetailChdText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Place of the row in a partial sort, apart from its status, which never depends on the selection -->
                    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding I18n[panel4.detail_selection]}"
                               IsVisible="{Binding PreviewTable.SelectedPreviewItem.SelectionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <SelectableTextBlock x:Name="LblDetailSelection" Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="5" FontSize="11" TextWrapping="Wrap"
                                         Text="{Binding PreviewTable.SelectedPreviewItem.SelectionText}"
                                         IsVisible="{Binding PreviewTable.SelectedPreviewItem.SelectionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Files transferred with the row (tracks, CHDs), with their target; scrolled beyond a few lines -->
                    <TextBlock Grid.Row="8" Grid.Column="0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Top"
                               Text="{Binding I18n[panel4.detail_related]}"
                               IsVisible="{Binding PreviewTable.SelectedPreviewItem.HasRelatedFiles, FallbackValue=False}" />
                    <ScrollViewer x:Name="ScrollDetailRelated"
                                  Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="5"
                                  MaxHeight="96"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding PreviewTable.SelectedPreviewItem.HasRelatedFiles, FallbackValue=False}">
                      <ItemsControl x:Name="ListDetailRelated" ItemsSource="{Binding PreviewTable.SelectedPreviewItem.RelatedFiles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PreviewRelatedFile">
                            <StackPanel Margin="0,0,0,2">
                              <SelectableTextBlock FontSize="11" TextWrapping="Wrap">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding SizeSuffix, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                              </SelectableTextBlock>
                              <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding TargetText, Mode=OneWay, StringFormat='→ {0}'}"
                                                   IsVisible="{Binding HasTarget}" />
                              <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding ChdText, Mode=OneWay}"
                                                   IsVisible="{Binding HasChdText}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Panel>
              </Expander>

              <!-- Preview table: 11 columns, of which the user chooses the shown ones -->
              <DataGrid x:Name="TablePreview"
                        MinHeight="82"
                        ItemsSource="{Binding PreviewTable.DisplayedRows}"
                        SelectedItem="{Binding PreviewTable.SelectedRow, Mode=TwoWay}"
                        SelectionMode="Extended"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="All"
                        HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                        VerticalGridLinesBrush="{DynamicResource GridLineBrush}"
                        Background="{DynamicResource SurfaceBrush}"
                        RowBackground="{DynamicResource SurfaceBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}">
                <DataGrid.ContextMenu>
                  <ContextMenu x:Name="PreviewContextMenu" DataContext="{Binding}">
                    <MenuItem Header="{Binding I18n[panel4.ctx_force_1g1r_winner]}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_ctx_force_1g1r]}"
                              Command="{Binding Force1G1RWinnerCommand}"
                              CommandParameter="{Binding SelectedPreviewItem}"
                              IsVisible="{Binding CanForce1G1RWinner}" />
                    <MenuItem Header="{Binding I18n[panel4.ctx_reset_1g1r_override]}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_ctx_reset_1g1r]}"
                              Command="{Binding Reset1G1ROverrideForGameCommand}"
                              CommandParameter="{Binding PreviewTable.SelectedRow}"
                              IsVisible="{Binding CanResetSelected1G1ROverride}" />
                    <MenuItem Header="{Binding ClearAll1G1ROverridesMenuText}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_ctx_clear_all_1g1r]}"
                              Command="{Binding ClearAll1G1ROverridesCommand}"
                              IsVisible="{Binding HasManual1G1ROverrides}"
                              IsEnabled="{Binding HasManual1G1ROverrides}" />
                    <Separator IsVisible="{Binding CanShowPreviewContextMenuSeparator}" />
                    <MenuItem Header="{Binding IsolateGameMenuText}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_ctx_filter_game]}"
                              Command="{Binding IsolateGameInPreviewCommand}"
                              CommandParameter="{Binding PreviewTable.SelectedRow}"
                              IsVisible="{Binding CanIsolateSelectedGame}" />
                    <MenuItem Header="{Binding I18n[panel4.ctx_clear_game_filter]}"
                              ToolTip.Tip="{Binding I18n[panel4.tooltip_ctx_clear_filter]}"
                              Command="{Binding ClearPreviewSearchCommand}"
                              IsVisible="{Binding HasPreviewSearchFilter}" />
                    <Separator />
                    <!-- Partial sort: checks the games of the rows selected in the grid -->
                    <MenuItem x:Name="MenuCheckSelectedRows"
                              Header="{Binding I18n[panel4.ctx_check_selected]}"
                              Command="{Binding PartialSort.CheckGridSelectionCommand}" />
                    <MenuItem x:Name="MenuUncheckSelectedRows"
                              Header="{Binding I18n[panel4.ctx_uncheck_selected]}"
                              Command="{Binding PartialSort.UncheckGridSelectionCommand}" />
                    <Separator IsVisible="{Binding PreviewTable.IsGroupedByGame}" />
                    <!-- Header of a game, in the view grouped by game -->
                    <MenuItem x:Name="MenuToggleGroup"
                              Header="{Binding PreviewTable.ToggleGroupMenuText}"
                              Command="{Binding PreviewTable.ToggleGroupCommand}"
                              CommandParameter="{Binding PreviewTable.SelectedGroupHeader}"
                              IsVisible="{Binding PreviewTable.IsGroupHeaderSelected}" />
                    <MenuItem x:Name="MenuCollapseAllGroups"
                              Header="{Binding I18n[panel4.ctx_collapse_all]}"
                              Command="{Binding PreviewTable.CollapseAllGroupsCommand}"
                              IsVisible="{Binding PreviewTable.IsGroupedByGame}" />
                    <MenuItem x:Name="MenuExpandAllGroups"
                              Header="{Binding I18n[panel4.ctx_expand_all]}"
                              Command="{Binding PreviewTable.ExpandAllGroupsCommand}"
                              IsVisible="{Binding PreviewTable.IsGroupedByGame}" />
                  </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{Binding PreviewColumnHeaders[0]}" Width="220" CanUserSort="True" SortMemberPath="SourceName">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PreviewRowViewModel">
                        <!-- Left marker of a row new or changed since the previous simulation -->
                        <DockPanel>
                          <Border x:Name="RowChangeMarker"
                                  DockPanel.Dock="Left"
                                  Width="3"
                                  Margin="0,1"
                                  IsVisible="{Binding IsChangedSinceLastRun}">
                            <Border.Background>
                              <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="RowChange*MarkerBrush">
                                <Binding Path="Change" />
                                <Binding Path="$self.ActualThemeVariant" />
                              </MultiBinding>
                            </Border.Background>
                          </Border>
                          <!-- Partial sort: chooses the game of the row (all the files of a header), checked and locked for a MAME
                               set a checked game needs; scaled down, as the template of a check box is taller than a
                               row of the table -->
                          <LayoutTransformControl DockPanel.Dock="Left"
                                                  Margin="4,0,0,0"
                                                  VerticalAlignment="Center"
                                                  LayoutTransform="scale(0.7, 0.7)">
                            <CheckBox x:Name="ChkRowSortCheck"
                                      MinWidth="0"
                                      Padding="0"
                                      Focusable="False"
                                      IsChecked="{Binding IsSortChecked, Mode=TwoWay}"
                                      IsEnabled="{Binding CanBeSortChecked}"
                                      ToolTip.Tip="{Binding SortCheckTooltip}"
                                      ToolTip.ShowOnDisabled="True"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PartialSort.ToggleRowCheckCommand}"
                                      CommandParameter="{Binding}" />
                          </LayoutTransformControl>
                          <!-- File of a game shown grouped: indented below the header of its game -->
                          <Border DockPanel.Dock="Left" Width="16" IsVisible="{Binding IsGroupMember}" />
                          <!-- Header of a game: chevron that folds or unfolds its files -->
                          <Button x:Name="BtnGroupToggle"
                                  Classes="group-toggle"
                                  DockPanel.Dock="Left"
                                  IsVisible="{Binding IsGroupHeader}"
                                  Command="{Binding ToggleCommand}"
                                  Focusable="False"
                                  Width="18"
                                  Height="18"
                                  MinHeight="18"
                                  Margin="3,0,0,0"
                                  Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">
                            <Panel>
                              <Path Data="M 0,0 L 5,4.5 L 0,9 Z"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    IsVisible="{Binding !IsExpanded}" />
                              <Path Data="M 0,0 L 9,0 L 4.5,5 Z"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    IsVisible="{Binding IsExpanded}" />
                            </Panel>
                          </Button>
                          <TextBlock x:Name="LblGroupCount"
                                     DockPanel.Dock="Right"
                                     Text="{Binding CountText}"
                                     IsVisible="{Binding IsGroupHeader}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                          <!-- Files transferred with the row (tracks, CHDs): detailed in the detail panel -->
                          <Border x:Name="RelatedBadge"
                                  DockPanel.Dock="Right"
                                  IsVisible="{Binding HasRelatedFiles}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Padding="5,0"
                                  CornerRadius="3"
                                  Background="{DynamicResource RelatedBadgeBackgroundBrush}"
                                  ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[panel4.tooltip_related_badge]}">
                            <TextBlock Text="{Binding RelatedFilesBadge}"
                                       FontSize="11"
                                       Foreground="{DynamicResource RelatedBadgeForegroundBrush}" />
                          </Border>
                          <TextBlock Text="{Binding SourceName}"
                                     Classes.group-title="{Binding IsGroupHeader}"
                                     Margin="6,0"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[1]}" Binding="{Binding Crc32Text}" Width="90" CanUserSort="False" IsVisible="{Binding PreviewTable.Columns[1].IsVisible}" />
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[2]}" Binding="{Binding TitleDisplay}" Width="170" IsVisible="{Binding PreviewTable.Columns[2].IsVisible}" />
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[3]}" Binding="{Binding DiskDisplay}" Width="105" IsVisible="{Binding PreviewTable.Columns[3].IsVisible}" />
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[4]}" Binding="{Binding Publisher}" Width="115" IsVisible="{Binding PreviewTable.Columns[4].IsVisible}" />
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[5]}" Binding="{Binding Date}" Width="85" IsVisible="{Binding PreviewTable.Columns[5].IsVisible}" />
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[6]}" Binding="{Binding LanguagesDisplay}" Width="110" IsVisible="{Binding PreviewTable.Columns[6].IsVisible}" />
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[7]}" Binding="{Binding CountriesDisplay}" Width="135" IsVisible="{Binding PreviewTable.Columns[7].IsVisible}" />
                  <!-- The target path takes the room left by the other columns -->
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[8]}" Binding="{Binding TargetPathDisplay}" Width="*" MinWidth="200" CanUserSort="False" IsVisible="{Binding PreviewTable.Columns[8].IsVisible}" />
                  <DataGridTemplateColumn Header="{Binding PreviewColumnHeaders[9]}" Width="140" CanUserResize="True" CanUserSort="True" SortMemberPath="StatusDisplay">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:PreviewRowViewModel">
                        <!-- Short status as a badge; the reason is in the tooltip and in the detail panel -->
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center">
                          <Border x:Name="StatusBadge"
                                  VerticalAlignment="Center"
                                  Padding="6,0"
                                  CornerRadius="3">
                            <Border.Background>
                              <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Status*BadgeBackgroundBrush">
                                <Binding Path="Status" />
                                <Binding Path="$self.ActualThemeVariant" />
                              </MultiBinding>
                            </Border.Background>
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                              <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="Status*BadgeForegroundBrush">
                                  <Binding Path="Status" />
                                  <Binding Path="$self.ActualThemeVariant" />
                                </MultiBinding>
                              </TextBlock.Foreground>
                            </TextBlock>
                          </Border>
                          <!-- 1G1R winner chosen by hand (the file, or the header of its game) -->
                          <Border x:Name="ForcedBadge"
                                  IsVisible="{Binding IsForcedWinner}"
                                  VerticalAlignment="Center"
                                  Padding="6,0"
                                  CornerRadius="3"
                                  Background="{DynamicResource ForcedBadgeBackgroundBrush}">
                            <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[panel4.badge_forced]}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForcedBadgeForegroundBrush}" />
                          </Border>
                          <!-- MAME set kept only because a kept set needs it (its BIOS, a device), or a game holding one -->
                          <Border x:Name="RequiredBadge"
                                  IsVisible="{Binding IsRequiredSet}"
                                  VerticalAlignment="Center"
                                  Padding="6,0"
                                  CornerRadius="3"
                                  Background="{DynamicResource RequiredBadgeBackgroundBrush}"
                                  ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[panel4.tooltip_required_set]}">
                            <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).I18n[panel4.badge_required]}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource RequiredBadgeForegroundBrush}" />
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- Number of related files: declared last, so that the indexes of the other columns did not change, and
                       shown after the disk column (MainWindow sets its display index) -->
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[10]}" Binding="{Binding RelatedCountText}" Width="100" IsVisible="{Binding PreviewTable.Columns[10].IsVisible}" />
                  <!-- DAT of a lot each file is sorted with: declared and shown last -->
                  <DataGridTextColumn Header="{Binding PreviewColumnHeaders[11]}" Binding="{Binding DatDisplay}" Width="160" IsVisible="{Binding PreviewTable.Columns[11].IsVisible}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Tab 1: Operations log -->
          <TabItem Header="{Binding I18n[panel4.tab_log]}"
                   ToolTip.Tip="{Binding I18n[panel4.tooltip_tab_log]}">
            <DockPanel Margin="0,2,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="2,0,2,3">
              <Button x:Name="BtnClearLog"
                      Classes="secondary-action"
                      Content="{Binding I18n[panel4.btn_clear_log]}"
                      ToolTip.Tip="{Binding I18n[panel4.tooltip_clear_log]}"
                      FontSize="11"
                      Padding="8,2"
                      Command="{Binding Log.ClearCommand}" />
            </StackPanel>
            <ListBox x:Name="LogViewerList"
                     MinHeight="110"
                     ItemsSource="{Binding Log.Entries}"
                     Background="{DynamicResource LogBackgroundBrush}"
                     Foreground="{DynamicResource LogForegroundBrush}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource LogBorderBrush}"
                     CornerRadius="4"
                     Padding="4"
                     FontFamily="Monospace"
                     FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding I18n[panel4.btn_clear_log]}"
                            ToolTip.Tip="{Binding I18n[panel4.tooltip_clear_log]}"
                            Command="{Binding Log.ClearCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="2,1" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource LogHoverBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource LogSelectionBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource LogSelectionBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                  <TextBlock FontFamily="Monospace"
                             FontSize="11"
                             Foreground="{DynamicResource LogTextBrush}"
                             TextWrapping="NoWrap">
                    <Run Text="{Binding LevelTag}"
                         FontWeight="Bold"><Run.Foreground>
                        <!-- A Run is not a control: the theme variant is the one of its TextBlock -->
                        <MultiBinding Converter="{StaticResource ThemeResource}" ConverterParameter="LogLevel*Brush|LogLevelDefaultBrush">
                          <Binding Path="Level" />
                          <Binding Path="$parent[TextBlock].ActualThemeVariant" />
                        </MultiBinding>
                      </Run.Foreground></Run><Run Text="{Binding SpacedCleanMessage}"
                         Foreground="{DynamicResource LogTextBrush}" />
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
          </TabItem>

        </TabControl>
      </DockPanel>

    </Panel>
  </DockPanel>
</Window>
