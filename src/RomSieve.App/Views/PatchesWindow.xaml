<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RomSieve.App.ViewModels"
        x:Class="RomSieve.App.Views.PatchesWindow"
        x:DataType="vm:PatchesViewModel"
        Title="{Binding I18n[patches.window_title]}"
        Width="1000"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        ShowInTaskbar="False"
        Icon="avares://RomSieve.App/Assets/icon.png"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="11"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- Same compact controls as the main window -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ListBox ListBoxItem">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- The mark of the state of a patch, in the colors of the badges of the table -->
    <Style Selector="TextBlock.mark">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.mark.toMatch">
      <Setter Property="Foreground" Value="{DynamicResource StatusExcludedBadgeForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.mark.applied">
      <Setter Property="Foreground" Value="{DynamicResource StatusValidBadgeForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.mark.unfixable">
      <Setter Property="Foreground" Value="{DynamicResource StatusDuplicateBadgeForegroundBrush}" />
    </Style>
    <!-- Set aside, or back to the automatic choice: neither a confirmation nor a warning -->
    <Style Selector="TextBlock.mark.neutral">
      <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16,14">
    <!-- What the window does, in a line; the whole explanation in its tooltip -->
    <TextBlock x:Name="LblPatchesHint"
               DockPanel.Dock="Top"
               Classes="hint"
               Margin="0,0,0,8"
               Text="{Binding I18n[patches.hint]}"
               ToolTip.Tip="{Binding I18n[patches.hint_tooltip]}" />

    <!-- The patches modified (or the simulation running) on the left; a new simulation, the window open, and closing on
         the right -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="LblPatchesModified"
                 DockPanel.Dock="Left"
                 VerticalAlignment="Center"
                 Text="{Binding ModifiedText}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnPatchesSimulateAgain"
                Classes="accent"
                MinWidth="85"
                HorizontalContentAlignment="Center"
                ToolTip.ShowOnDisabled="True"
                Content="{Binding I18n[patches.btn_simulate_again]}"
                ToolTip.Tip="{Binding I18n[patches.tooltip_simulate_again]}"
                Command="{Binding SimulateAgainCommand}" />
        <Button x:Name="BtnPatchesClose"
                MinWidth="85"
                HorizontalContentAlignment="Center"
                IsCancel="True"
                IsEnabled="{Binding !IsSimulating}"
                Content="{Binding I18n[patches.btn_close]}"
                ToolTip.Tip="{Binding I18n[patches.tooltip_close]}"
                Click="OnCloseClick" />
      </StackPanel>
    </DockPanel>

    <Grid ColumnDefinitions="2*,8,3*">
      <!-- The patches, grouped by state: the title of each group, then its patches -->
      <Border Classes="panel" Padding="2">
        <ListBox x:Name="ListPatches"
                 Background="Transparent"
                 AutomationProperties.Name="{Binding I18n[patches.window_title]}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding ListItems}"
                 SelectedItem="{Binding SelectedListItem, Mode=TwoWay}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:PatchGroupViewModel">
              <DockPanel Margin="0,6,0,2">
                <Button DockPanel.Dock="Right"
                        Padding="6,0"
                        MinHeight="20"
                        Content="{Binding BatchLabel}"
                        ToolTip.Tip="{Binding BatchTooltip}"
                        IsVisible="{Binding HasBatch}"
                        Command="{Binding BatchCommand}"
                        CommandParameter="{Binding Kind}" />
                <TextBlock VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HintForegroundBrush}"
                           Text="{Binding Title}" />
              </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:PatchRowViewModel">
              <DockPanel Margin="8,0,0,0"
                         ToolTip.Tip="{Binding Location}"
                         AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock DockPanel.Dock="Left"
                           Width="16"
                           VerticalAlignment="Top"
                           Classes="mark"
                           Classes.toMatch="{Binding IsToMatch}"
                           Classes.applied="{Binding IsApplied}"
                           Classes.unfixable="{Binding IsUnfixable}"
                           Classes.neutral="{Binding IsNeutral}"
                           Text="{Binding StateMark}" />
                <StackPanel Spacing="1">
                  <TextBlock FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                  <TextBlock Foreground="{DynamicResource HintForegroundBrush}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding ListSummary}"
                             IsVisible="{Binding ListSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="panel" Padding="12,10">
        <Panel>
          <!-- The patch selected: where it stands, its ROM, what applying would rename, and its actions -->
          <ScrollViewer x:Name="PanelPatchDetail"
                        HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding !IsBatchMode}">
            <StackPanel IsVisible="{Binding HasSelectedRow}">
              <TextBlock FontWeight="Bold"
                         FontSize="13"
                         TextWrapping="Wrap"
                         Text="{Binding SelectedRow.Name, FallbackValue=''}" />
              <TextBlock Classes="hint"
                         Text="{Binding SelectedRow.Location, FallbackValue=''}"
                         IsVisible="{Binding SelectedRow.HasLocation, FallbackValue=False}" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left"
                           Width="16"
                           Classes="mark"
                           Classes.toMatch="{Binding SelectedRow.IsToMatch, FallbackValue=False}"
                           Classes.applied="{Binding SelectedRow.IsApplied, FallbackValue=False}"
                           Classes.unfixable="{Binding SelectedRow.IsUnfixable, FallbackValue=False}"
                           Classes.neutral="{Binding SelectedRow.IsNeutral, FallbackValue=False}"
                           Text="{Binding SelectedRow.StateMark, FallbackValue=''}" />
                <TextBlock x:Name="LblPatchState"
                           TextWrapping="Wrap"
                           Text="{Binding SelectedRow.StatusText, FallbackValue=''}" />
              </DockPanel>
              <!-- The name of its patched version in the last run, as long as nothing changed it -->
              <TextBlock x:Name="LblPatchedName"
                         Margin="16,2,0,0"
                         Classes="hint"
                         Text="{Binding SelectedRow.PatchedNameText, FallbackValue=''}"
                         IsVisible="{Binding SelectedRow.HasPatchedName, FallbackValue=False}" />

              <StackPanel IsVisible="{Binding SelectedRow.CanChoose, FallbackValue=False}">
                <TextBlock Classes="section" Text="{Binding I18n[patches.question]}" />
                <!-- Ctrl+F comes here; Enter takes the first file found, and never renames anything -->
                <TextBox x:Name="EditPatchOriginSearch"
                         Watermark="{Binding I18n[patches.search_watermark]}"
                         ToolTip.Tip="{Binding I18n[patches.tooltip_search]}"
                         AutomationProperties.Name="{Binding I18n[patches.question]}"
                         IsEnabled="{Binding CanSearch}"
                         Text="{Binding OriginSearchText, Mode=TwoWay}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ChooseFirstSearchResultCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>

                <TextBlock Classes="hint" Margin="0,8,0,2" Text="{Binding I18n[patches.suggestions_header]}" />
                <TextBlock Classes="hint"
                           FontStyle="Italic"
                           Text="{Binding I18n[patches.origin_placeholder]}"
                           IsVisible="{Binding !SelectedRow.HasOrigins, FallbackValue=False}" />
                <ListBox x:Name="ListPatchOrigins"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding I18n[patches.suggestions_header]}"
                         IsEnabled="{Binding CanSearch}"
                         ItemsSource="{Binding SelectedRow.Origins, FallbackValue={x:Null}}"
                         SelectedItem="{Binding SelectedRow.SelectedOrigin, Mode=TwoWay, FallbackValue={x:Null}}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PatchOriginOptionViewModel">
                      <!-- Its folder under its name: two files of the same name tell apart; then why it is proposed -->
                      <RadioButton IsHitTestVisible="False"
                                   IsChecked="{Binding $parent[ListBoxItem].IsSelected}"
                                   AutomationProperties.Name="{Binding Label}"
                                   ToolTip.Tip="{Binding Location}">
                        <StackPanel>
                          <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                          <TextBlock Foreground="{DynamicResource HintForegroundBrush}"
                                     TextWrapping="NoWrap"
                                     TextTrimming="PathSegmentEllipsis"
                                     Text="{Binding Folder}"
                                     IsVisible="{Binding HasFolder}" />
                          <TextBlock Foreground="{DynamicResource HintForegroundBrush}"
                                     FontStyle="Italic"
                                     TextWrapping="Wrap"
                                     Text="{Binding Reason}"
                                     IsVisible="{Binding HasReason}" />
                        </StackPanel>
                      </RadioButton>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding HasSearchResults}">
                  <TextBlock Classes="hint" Margin="0,8,0,2" Text="{Binding I18n[patches.search_header]}" />
                  <ListBox x:Name="ListPatchOriginResults"
                           MaxHeight="160"
                           AutomationProperties.Name="{Binding I18n[patches.search_header]}"
                           Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ItemsSource="{Binding OriginSearchResults}"
                           SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PatchOriginOptionViewModel">
                        <Grid ColumnDefinitions="Auto,8,*">
                          <TextBlock TextWrapping="NoWrap" Text="{Binding Label}" />
                          <TextBlock Grid.Column="2"
                                     Foreground="{DynamicResource HintForegroundBrush}"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Location}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>

                <!-- Only for a ROM with a copier header: its two forms -->
                <StackPanel IsVisible="{Binding SelectedRow.HasSeveralForms, FallbackValue=False}">
                  <TextBlock Classes="hint"
                             Margin="0,8,0,2"
                             Text="{Binding I18n[patches.form_label]}"
                             ToolTip.Tip="{Binding I18n[patches.tooltip_form]}" />
                  <ListBox x:Name="ListPatchForms"
                           Background="Transparent"
                           AutomationProperties.Name="{Binding I18n[patches.form_label]}"
                           ItemsSource="{Binding SelectedRow.Forms, FallbackValue={x:Null}}"
                           SelectedItem="{Binding SelectedRow.SelectedForm, Mode=TwoWay, FallbackValue={x:Null}}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PatchFormOptionViewModel">
                        <RadioButton IsHitTestVisible="False"
                                     IsChecked="{Binding $parent[ListBoxItem].IsSelected}"
                                     AutomationProperties.Name="{Binding Label}"
                                     Content="{Binding Label}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </StackPanel>

              <TextBlock x:Name="LblPatchResult"
                         Margin="0,10,0,0"
                         FontWeight="Bold"
                         Foreground="{DynamicResource SizeWarningForegroundBrush}"
                         TextWrapping="Wrap"
                         Text="{Binding SelectedRow.ResultText, FallbackValue=''}"
                         IsVisible="{Binding SelectedRow.ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />

              <!-- The choice of the user: recorded by RomSieve, no file changes -->
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="BtnPatchApply"
                        Margin="0,0,8,4"
                        Classes="accent"
                        Content="{Binding I18n[patches.btn_apply]}"
                        ToolTip.Tip="{Binding SelectedRow.ApplyTooltip, FallbackValue=''}"
                        ToolTip.ShowOnDisabled="True"
                        IsVisible="{Binding SelectedRow.CanChoose, FallbackValue=False}"
                        Command="{Binding ApplyCommand}" />
                <Button x:Name="BtnPatchIgnore"
                        Margin="0,0,8,4"
                        Content="{Binding I18n[patches.btn_ignore]}"
                        ToolTip.Tip="{Binding SelectedRow.IgnoreTooltip, FallbackValue=''}"
                        ToolTip.ShowOnDisabled="True"
                        Command="{Binding IgnoreCommand}" />
                <Button x:Name="BtnPatchAutomatic"
                        Margin="0,0,8,4"
                        Content="{Binding I18n[patches.btn_automatic]}"
                        ToolTip.Tip="{Binding I18n[patches.tooltip_automatic]}"
                        IsVisible="{Binding SelectedRow.CanRestoreAutomatic, FallbackValue=False}"
                        Command="{Binding RestoreAutomaticCommand}" />
                <Button x:Name="BtnPatchUndo"
                        Margin="0,0,8,4"
                        Content="{Binding I18n[patches.btn_undo]}"
                        ToolTip.Tip="{Binding I18n[patches.tooltip_undo]}"
                        IsVisible="{Binding SelectedRow.CanUndo, FallbackValue=False}"
                        Command="{Binding UndoCommand}" />
              </WrapPanel>

              <!-- For other tools only: the actions that rename the patch, never in an archive; the ROM written in its name,
                   or removed from it, also after a new simulation, when « Undo » no longer can -->
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="BtnPatchWriteName"
                        Margin="0,0,8,4"
                        Content="{Binding I18n[patches.btn_write_rom_in_name]}"
                        ToolTip.Tip="{Binding SelectedRow.WriteNameTooltip, FallbackValue=''}"
                        IsVisible="{Binding SelectedRow.CanWriteName, FallbackValue=False}"
                        Command="{Binding WriteNameCommand}" />
                <Button x:Name="BtnPatchClearName"
                        Margin="0,0,8,4"
                        Content="{Binding I18n[patches.btn_clear_rom_from_name]}"
                        ToolTip.Tip="{Binding SelectedRow.ClearNameTooltip, FallbackValue=''}"
                        IsVisible="{Binding SelectedRow.CanClearName, FallbackValue=False}"
                        Command="{Binding ClearNameCommand}" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- The summary of « Accept all the suggestions »: each patch with its ROM, nothing checked -->
          <DockPanel x:Name="PanelPatchBatch" IsVisible="{Binding IsBatchMode}">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding I18n[patches.batch_title_accept]}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
              <Button x:Name="BtnPatchBatchCheckAll" Content="{Binding I18n[patches.btn_batch_check_all]}" Command="{Binding CheckAllBatchCommand}" />
              <Button x:Name="BtnPatchBatchApply" Classes="accent" Content="{Binding ApplyBatchLabel}" Command="{Binding ApplyBatchCommand}" />
              <Button x:Name="BtnPatchBatchBack" Content="{Binding I18n[patches.btn_batch_back]}" Command="{Binding CloseBatchCommand}" />
            </StackPanel>
            <ListBox x:Name="ListPatchBatch"
                     Margin="0,8,0,0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding BatchEntries}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PatchBatchEntryViewModel">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left"
                              VerticalAlignment="Top"
                              MinWidth="0"
                              Margin="0,0,6,0"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Name}" />
                    <StackPanel Spacing="1">
                      <TextBlock FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock Foreground="{DynamicResource HintForegroundBrush}"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis">
                        <Run Text="→ " />
                        <Run Text="{Binding OriginLabel}" />
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Panel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
