<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RomSieve.App</RootNamespace>
    <AssemblyName>RomSieve.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- File description of the executable, shown by the task manager under Windows -->
    <AssemblyTitle>RomSieve</AssemblyTitle>
    <Description>Interface of RomSieve: audits, filters, deduplicates (1G1R) and reorganizes TOSEC, No-Intro, Redump and MAME collections.</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Include="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomSieve.Core\RomSieve.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RomSieve.App.Tests" />
  </ItemGroup>

  <!-- Licenses of the third-party components, next to the executable -->
  <Import Project="..\ThirdPartyNotices.targets" />

</Project>
